def install_self():
    source = Path(__file__).resolve()
    safe(SELF)
    if source == SELF.resolve():
        install_spotify_open_helper()
        install_spotify_snapctl_helper()
        return
    safe(SELF.parent).mkdir(parents=True, exist_ok=True)
    managed_file(SELF, source.read_text(), 0o755)
    if digest(source) != digest(SELF):
        raise RuntimeError('Installed script differs after update; inspect before proceeding')
    compatibility_launcher('thin-client-setup', SELF)
    install_spotify_open_helper()
    install_spotify_snapctl_helper()
    # Upgrade existing managed launchers even when this post's goinfre is
    # read-only and therefore cannot run a full prepare/install operation.
    for name in ('brave-native', 'code-native', 'code', 'spotify', 'spotify-native',
                 'codex', 'claude'):
        launcher = HOME / '.local/bin' / name
        if (launcher.is_file() and not launcher.is_symlink() and
                '# Managed by thin-client-setup' in launcher.read_text()):
            compatibility_launcher(name, launcher)
    print(f'Installed setup {VERSION}: {SELF}; SHA-256 {digest(SELF)}', flush=True)

def script_status():
    """Compare script bytes, without mistaking a git pull for an installed update."""
    source = Path(__file__).resolve()
    print(f'Executing setup {VERSION}: {source}; SHA-256 {digest(source)}', flush=True)
    if (source.parent / '.git').exists():
        result = run(['git', '-C', source.parent, 'rev-parse', 'HEAD'],
                     capture_output=True, text=True)
        print(f'Checkout HEAD: {result.stdout.strip()} (script hash includes local edits)', flush=True)
    if SELF.is_file():
        installed_hash = digest(SELF)
        print(f'Installed setup: {SELF}; SHA-256 {installed_hash}', flush=True)
        if installed_hash != digest(source):
            print('UPDATE REQUIRED: run ./thin-client-setup install-self from the reviewed checkout', flush=True)
        else:
            print('Installed script matches executing script.', flush=True)
    else:
        print('Installed script missing: run ./thin-client-setup install-self from the reviewed checkout', flush=True)
    if source == SELF.resolve():
        print('Repository version unknown from installed copy; run ./thin-client-setup status '
              'in the checkout after git pull to compare.', flush=True)

def xdg_environment():
