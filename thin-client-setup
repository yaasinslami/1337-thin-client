def runtime_storage(root):
    """Use goinfre when writable; otherwise use private, disposable local storage."""
    root = Path(root)
    if root.is_dir() and os.access(root, os.W_OK | os.X_OK):
        return root
    runtime = safe(transient_runtime_path())
    if runtime.exists():
        if (not runtime.is_dir() or runtime.is_symlink() or
                runtime.stat().st_uid != os.getuid()):
            raise RuntimeError(f'Unsafe transient runtime directory: {runtime}')
    else:
        runtime.mkdir(mode=0o700)
    runtime.chmod(0o700)
    return runtime

def stopped(apps=('brave', 'vscode', 'spotify')):
    # /proc can be namespace-filtered in Codex; flatpak ps is also mandatory.
    if shutil.which('flatpak'):
        r = run(['flatpak', 'ps', '--columns=application'], capture_output=True, text=True)
        ids = [APP_IDS[a] for a in apps if a in APP_IDS]
        if any(x in r.stdout.splitlines() for x in ids):
            raise RuntimeError('Quit the relevant Flatpak applications before proceeding')
    names = set()
    if 'brave' in apps:
        names.update(['brave', 'brave-browser'])
    if 'vscode' in apps:
        names.update(['code', 'code-insiders'])
    if 'spotify' in apps:
        names.add('spotify')
    r = run(['ps', '-eo', 'uid=,pid=,comm='], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        fields = line.split()
        if len(fields) == 3 and fields[0] == str(os.getuid()) and fields[2].lower() in names:
            raise RuntimeError(f'Quit application before migration/update: {fields[2]} PID {fields[1]}')

def url_checked(url):
    p = urllib.parse.urlparse(url)
    host = p.hostname or ''
    allowed = ['versions.brave.com', 'github.com', 'update.code.visualstudio.com',
               'vscode.download.prss.microsoft.com', 'az764295.vo.msecnd.net',
               'chatgpt.com', 'downloads.claude.ai']
    if p.scheme != 'https' or p.username or p.password or host not in allowed:
        raise RuntimeError(f'Unexpected official download URL host: {host}')
    return url

def fetch(url, path):
    url_checked(url)
    run(['curl', '-fL', '--proto', '=https', '--proto-redir', '=https',
         '--connect-timeout', '20', '--max-time', '600', '--retry', '2',
         '-o', path, url])

def text_url(url, directory, name):
    p = directory / name
    fetch(url, p)
    return p.read_text().strip()

def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as f:
        for block in iter(lambda: f.read(1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()

def verify_checksum(path, expected):
    if not re.fullmatch(r'[0-9a-fA-F]{64}', expected) or digest(path).lower() != expected.lower():
        raise RuntimeError('SHA-256 verification failed; existing installation unchanged')

def extract(archive, dest, kind):
    """Reject archive traversal, special files and links escaping extraction root."""
    safe(dest)
    if any(dest.iterdir()):
        raise RuntimeError('Extraction requires an empty private directory')
    def inside(name):
        p = PurePosixPath(name)
        if not name or p.is_absolute() or '..' in p.parts or '\\' in name:
            raise RuntimeError('Unsafe archive member path')
    if kind == 'zip':
        with zipfile.ZipFile(archive) as z:
            for m in z.infolist():
                inside(m.filename)
                mode = m.external_attr >> 16
                if stat.S_IFMT(mode) not in [0, stat.S_IFREG, stat.S_IFDIR]:
                    raise RuntimeError('Unexpected special file/link in Brave ZIP')
            z.extractall(dest)
            for m in z.infolist():
                p = dest / m.filename
                mode = (m.external_attr >> 16) & 0o777
                if mode:
                    p.chmod(mode)
    else:
        with tarfile.open(archive, 'r:gz') as t:
            members = t.getmembers()
            links = {PurePosixPath(m.name) for m in members if m.issym() or m.islnk()}
            seen = set()
            for m in members:
                inside(m.name)
                name = PurePosixPath(m.name)
                if name in seen or any(parent in links for parent in name.parents):
                    raise RuntimeError('Duplicate archive member or link ancestor')
                seen.add(name)
                if not (m.isfile() or m.isdir() or m.issym() or m.islnk()):
                    raise RuntimeError('Unexpected special file in VS Code archive')
                if m.issym() or m.islnk():
                    link = PurePosixPath(m.linkname)
                    if link.is_absolute() or '\\' in m.linkname:
                        raise RuntimeError('Absolute archive link')
                    target = (dest / m.name).parent / m.linkname if m.issym() else dest / m.linkname
                    if not target.resolve().is_relative_to(dest.resolve()):
                        raise RuntimeError('Escaping archive link')
                    relative = target.resolve().relative_to(dest.resolve())
                    if any(link_path in relative.parents or
                           link_path == relative for link_path in links):
                        raise RuntimeError('Archive link chains are not supported')
            # Never let archive links redirect writes, and strip setuid/setgid bits.
            for m in members:
                p = dest / m.name
                if m.isdir():
                    p.mkdir(parents=True, exist_ok=True)
                elif m.isfile():
                    p.parent.mkdir(parents=True, exist_ok=True)
                    with t.extractfile(m) as src, p.open('xb') as dst:
                        shutil.copyfileobj(src, dst)
                    p.chmod(m.mode & 0o777)
            for m in members:
                p = dest / m.name
                if m.issym() or m.islnk():
                    p.parent.mkdir(parents=True, exist_ok=True)
                    if m.issym():
                        p.symlink_to(m.linkname)
                    else:
                        os.link(dest / m.linkname, p)

def switch(link, target):
    if link.exists() and not link.is_symlink():
        raise RuntimeError(f'Refusing to replace non-symlink: {link}')
    tmp = link.with_name('current.pending')
    if tmp.exists() or tmp.is_symlink():
        raise RuntimeError(f'Previous pending activation exists: {tmp}')
    tmp.symlink_to(target)
    os.replace(tmp, link)

def install_app(root, app, version, url, sha, kind, work):
    if not re.fullmatch(r'[0-9A-Za-z._-]+', version) or not re.fullmatch(r'[0-9a-fA-F]{64}', sha):
        raise RuntimeError(f'Invalid version/checksum for {app}')
    appdir = safe(root / 'apps' / app)
    releases = safe(appdir / 'releases')
    dest = safe(releases / version)
    exe = 'brave' if app == 'brave' else 'bin/code'
    releases.mkdir(parents=True, exist_ok=True)
    if dest.exists():
        receipt = json.loads((dest / '.thin-client-install.json').read_text())
        if receipt.get('sha256') != sha or not os.access(dest / exe, os.X_OK):
            raise RuntimeError(f'Existing release is incomplete/unrecognized: {dest}')
        print(f'Already installed: {dest}', flush=True)
    else:
        if shutil.disk_usage(root).free < 3 * 1024**3:
            raise RuntimeError('Need at least 3 GiB free in goinfre for staged downloads')
        archive = work / (app + ('.zip' if kind == 'zip' else '.tar.gz'))
        fetch(url, archive)
        verify_checksum(archive, sha)
        print(f'Verified SHA-256: {app} {sha}', flush=True)
        unpack = work / (app + '-unpacked')
        unpack.mkdir(mode=0o700)
        extract(archive, unpack, kind)
        payload = unpack if app == 'brave' else unpack / 'VSCode-linux-x64'
        if not os.access(payload / exe, os.X_OK):
            raise RuntimeError(f'Missing executable in {app} archive')
        (payload / '.thin-client-install.json').write_text(json.dumps({
            'version': version, 'sha256': sha.lower(), 'url': url}, indent=2) + '\n')
        payload.rename(dest)
        print(f'Installed new release: {dest}', flush=True)
    switch(appdir / 'current', dest)
    # Prior releases/downloads are intentionally retained, never auto-cleaned.
    print(f'Activated: {appdir / "current"} -> {dest}', flush=True)

def snap_assertion(path, expected_id, label):
    """Read and pin one store-issued snap-revision assertion."""
    text = path.read_text()
    sections = re.split(r'(?=^type: )', text, flags=re.MULTILINE)
    for section in sections:
        header = section.split('\n\n', 1)[0]
        fields = dict(re.findall(r'^([a-z0-9-]+): (.+)$', header, re.MULTILINE))
        if fields.get('type') != 'snap-revision':
            continue
        required = ('snap-id', 'snap-revision', 'snap-size', 'snap-sha3-384')
        if any(not fields.get(name) for name in required):
            raise RuntimeError(f'Incomplete {label} Snap Store assertion')
        if fields['snap-id'] != expected_id:
            raise RuntimeError(f'Downloaded snap does not have {label}\'s pinned Store identity')
        if not fields['snap-revision'].isdigit() or not fields['snap-size'].isdigit():
            raise RuntimeError(f'Invalid {label} Snap Store revision metadata')
        if not re.fullmatch(r'[A-Za-z0-9_-]{64}', fields['snap-sha3-384']):
            raise RuntimeError(f'Invalid {label} Snap Store SHA3-384')
        return fields
    raise RuntimeError(f'{label} snap-revision assertion is missing')

def spotify_assertion(path):
    return snap_assertion(path, SPOTIFY_SNAP_ID, 'Spotify')

def sha3_384_file(path):
    value = hashlib.sha3_384()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(block)
    return base64.urlsafe_b64encode(value.digest()).decode().rstrip('=')

def yaml_scalar(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        value = value[1:-1]
    return value

def spotify_snap_metadata(path):
    """Read only the small, required subset of the trusted snap.yaml file."""
    text = path.read_text()
    def top(name):
        match = re.search(rf'^{re.escape(name)}:\s*([^#\n]+)', text, re.MULTILINE)
        if not match:
            raise RuntimeError(f'Spotify snap metadata lacks {name}')
        return yaml_scalar(match.group(1))
    name, version, base = top('name'), top('version'), top('base')
    if name != 'spotify' or not re.fullmatch(r'[0-9A-Za-z.+_-]+', version):
        raise RuntimeError('Unexpected Spotify snap name/version')
    if base != SPOTIFY_BASE:
        raise RuntimeError(f'Unsupported Spotify snap base: {base}')
    lines = text.splitlines()
    app_start = next((index for index, line in enumerate(lines)
                      if re.fullmatch(r'  spotify:\s*', line)), None)
    if app_start is None:
        raise RuntimeError('Spotify snap app declaration is missing')
    block = []
    for line in lines[app_start + 1:]:
        if line and not line.startswith('    '):
            break
        block.append(line)
    command = next((yaml_scalar(line.split(':', 1)[1]) for line in block
                    if re.match(r'^    command:\s*\S', line)), None)
    if not command:
        raise RuntimeError('Spotify snap command is missing')
    command_tokens = shlex.split(command)
    if not command_tokens or '/' not in command_tokens[0]:
        raise RuntimeError('Unexpected Spotify snap command')
    chains = []
    in_chain = False
    for line in block:
        if re.match(r'^    command-chain:\s*$', line):
            in_chain = True
            continue
        # YAML permits a block sequence to be indented either beneath its key
        # or at the key's own indentation level.  snapcraft emits the latter:
        #     command-chain:
        #     - snap/command-chain/desktop-launch
        if in_chain and re.match(r'^ {4,6}-\s*\S', line):
            chains.append(yaml_scalar(re.sub(r'^ {4,6}-\s*', '', line, count=1)))
        elif in_chain and line.strip() and not re.match(r'^ {6,}', line):
            in_chain = False
    if any('/' not in item or any(char.isspace() for char in item) for item in chains):
        raise RuntimeError('Unexpected Spotify snap command chain')
    return {'version': version, 'base': base, 'command': command_tokens,
            'command_chain': chains}

def snap_path(release, value):
    value = value.replace('${SNAP}', str(release)).replace('$SNAP', str(release))
    candidate = Path(value) if value.startswith('/') else release / value
    resolved = candidate.resolve()
    if not resolved.is_relative_to(release.resolve()):
        raise RuntimeError(f'Spotify snap command escapes its release: {value}')
    return resolved

def spotify_launch(root, release=None, metadata=None):
    release = release or spotify_release(root)[0]
    if metadata is None:
        metadata = spotify_release(root)[1]
    paths = [snap_path(release, value) for value in metadata['command_chain']]
    paths.append(snap_path(release, metadata['command'][0]))
    for executable in paths:
        if not executable.is_file() or not os.access(executable, os.X_OK):
            raise RuntimeError(f'Spotify executable is missing: {executable}')
    argv = [*paths, *metadata['command'][1:]]
    return paths[0], argv

def snap_runtime_release(root, name):
    """Validate and return one active managed runtime extracted from the Store."""
    if name not in SPOTIFY_RUNTIME_SNAP_IDS:
        raise RuntimeError(f'Unknown Spotify runtime: {name}')
    appdir = root / 'apps/snap-runtimes' / name
    current = appdir / 'current'
    if not current.is_symlink():
        raise RuntimeError(f'Spotify runtime {name} is missing: run '
                           'thin-client-setup spotify prepare')
    release = current.resolve()
    if not release.is_relative_to((appdir / 'releases').resolve()):
        raise RuntimeError(f'Spotify runtime link escapes managed storage: {current}')
    receipt = release / '.thin-client-install.json'
    if not receipt.is_file() or receipt.is_symlink():
        raise RuntimeError(f'Spotify runtime receipt is missing: {name}')
    metadata = json.loads(receipt.read_text())
    if (metadata.get('backend') != 'official-snap-runtime' or
            metadata.get('name') != name or
            metadata.get('snap_id') != SPOTIFY_RUNTIME_SNAP_IDS[name]):
        raise RuntimeError(f'Unexpected Spotify runtime receipt: {receipt}')
    return release, metadata

def ensure_spotify_mountpoints(release):
    """Create empty targets used only for nested read-only runtime mounts."""
    for relative in ('gnome-platform', 'gpu-2404', 'data-dir/themes',
                     'data-dir/icons', 'data-dir/sounds'):
        target = release / relative
        if target.exists() and not target.is_dir():
            raise RuntimeError(f'Unexpected Spotify runtime mount target: {target}')
        target.mkdir(parents=True, exist_ok=True)

def spotify_layout_mounts(core, gnome, mesa):
    """Recreate the filesystem layouts snapd applies to the Spotify snap."""
    layouts = (
        (gnome / 'usr/lib/x86_64-linux-gnu/webkit2gtk-4.0',
         core / 'usr/lib/x86_64-linux-gnu/webkit2gtk-4.0', 'dir', True),
        (gnome / 'usr/lib/x86_64-linux-gnu/webkit2gtk-4.1',
         core / 'usr/lib/x86_64-linux-gnu/webkit2gtk-4.1', 'dir', False),
        (gnome / 'usr/share/xml/iso-codes',
         core / 'usr/share/xml/iso-codes', 'dir', False),
        (mesa / 'libdrm', core / 'usr/share/libdrm', 'dir', False),
        (mesa / 'drirc.d', core / 'usr/share/drirc.d', 'dir', False),
        (mesa / 'X11/XErrorDB', core / 'usr/share/X11/XErrorDB', 'file', False),
    )
    mounts = []
    for source, target, kind, optional in layouts:
        if not source.exists():
            if optional:
                continue
            raise RuntimeError(f'Spotify runtime layout source is missing: {source}')
        resolved_source = source.resolve()
        provider = gnome if source.is_relative_to(gnome) else mesa
        if not resolved_source.is_relative_to(provider.resolve()):
            raise RuntimeError(f'Spotify runtime layout escapes its provider: {source}')
        source_ok = resolved_source.is_dir() if kind == 'dir' else resolved_source.is_file()
        if not source_ok:
            raise RuntimeError(f'Unexpected Spotify runtime layout source: {source}')
        try:
            target.parent.mkdir(parents=True, exist_ok=True)
            if target.is_symlink():
                raise RuntimeError(f'Unexpected Spotify runtime layout target: {target}')
            if kind == 'dir':
                if target.exists() and not target.is_dir():
                    raise RuntimeError(f'Unexpected Spotify runtime layout target: {target}')
                target.mkdir(exist_ok=True)
            else:
                if target.exists() and not target.is_file():
                    raise RuntimeError(f'Unexpected Spotify runtime layout target: {target}')
                target.touch(exist_ok=True)
        except OSError as error:
            raise RuntimeError('Spotify layouts are not initialized and goinfre is read-only; '
                               'run `thin-client-setup spotify prepare` once from a writable post') from error
        if not target.resolve().is_relative_to(core.resolve()):
            raise RuntimeError(f'Spotify runtime layout target escapes core24: {target}')
        mounts.append((resolved_source, target))
    return mounts

def spotify_release(root):
    """Return and validate the active official Spotify Snap extraction."""
    current = root / 'apps/spotify/current'
    if not current.is_symlink():
        raise RuntimeError('Spotify app missing: run thin-client-setup spotify prepare')
    release = current.resolve()
    if not release.is_relative_to((root / 'apps/spotify/releases').resolve()):
        raise RuntimeError(f'Spotify release link escapes managed storage: {current}')
    receipt = release / '.thin-client-install.json'
    if not receipt.is_file() or receipt.is_symlink():
        raise RuntimeError('Spotify app receipt is missing')
    receipt_metadata = json.loads(receipt.read_text())
    if (receipt_metadata.get('backend') != 'official-spotify-snap' or
            receipt_metadata.get('snap_id') != SPOTIFY_SNAP_ID or
            receipt_metadata.get('base') != SPOTIFY_BASE or
            not isinstance(receipt_metadata.get('command'), list) or
            not isinstance(receipt_metadata.get('command_chain'), list)):
        raise RuntimeError(f'Unexpected Spotify app receipt: {receipt}')
    # The signed/extracted snap.yaml is the runtime authority.  Older script
    # versions misread Snapcraft's legal indentation-less command-chain list
    # and wrote an empty chain to otherwise valid receipts.  Repair that in
    # memory so existing installations work immediately, without downloading.
    parsed = spotify_snap_metadata(release / 'meta/snap.yaml')
    if (parsed['version'] != receipt_metadata.get('version') or
            parsed['base'] != receipt_metadata.get('base')):
        raise RuntimeError(f'Spotify snap metadata differs from its receipt: {release}')
    metadata = dict(receipt_metadata)
    metadata['command'] = parsed['command']
    metadata['command_chain'] = parsed['command_chain']
    spotify_launch(root, release, metadata)
    ensure_spotify_mountpoints(release)
    return release, metadata

def validate_snap_tree(directory, allow_external_links=False):
    """Reject special files and escaping links after unsquashfs extraction."""
    root = directory.resolve()
    for path in directory.rglob('*'):
        details = path.lstat()
        if path.is_symlink():
            if not allow_external_links and not path.resolve().is_relative_to(root):
                raise RuntimeError(f'Escaping link in Spotify snap: {path}')
        elif path.is_file() or path.is_dir():
            if details.st_mode & (stat.S_ISUID | stat.S_ISGID):
                path.chmod(stat.S_IMODE(details.st_mode) & 0o777)
        else:
            raise RuntimeError(f'Unexpected special file in Spotify snap: {path}')

def install_snap_runtime(root, name, work):
    """Download, verify and activate a signed Snap runtime in goinfre."""
    expected_id = SPOTIFY_RUNTIME_SNAP_IDS[name]
    runtime_work = work / name
    runtime_work.mkdir(mode=0o700, exist_ok=True)
    snap = runtime_work / f'{name}.snap'
    assertion = runtime_work / f'{name}.assert'
    if not snap.is_file() or not assertion.is_file():
        run(['snap', 'download', name, '--stable', f'--basename={name}',
             f'--target-directory={runtime_work}'])
    fields = snap_assertion(assertion, expected_id, name)
    if snap.stat().st_size != int(fields['snap-size']):
        raise RuntimeError(f'{name} snap size differs from its Store assertion')
    actual_sha3 = sha3_384_file(snap)
    if actual_sha3 != fields['snap-sha3-384']:
        raise RuntimeError(f'{name} snap hash differs from its Store assertion')
    unpack = runtime_work / f'{name}-unpacked'
    complete = unpack / '.thin-client-extraction-complete'
    if not complete.is_file():
        if unpack.exists() or unpack.is_symlink():
            if not unpack.is_dir() or unpack.is_symlink():
                raise RuntimeError(f'Unexpected incomplete {name} extraction: {unpack}')
            backup = runtime_work / f'{name}-unpacked.incomplete-{time.time_ns()}'
            safe(unpack)
            safe(backup)
            unpack.rename(backup)
            print(f'Retained incomplete {name} extraction: {backup}', flush=True)
        # Base snaps contain /dev placeholders and root-only capability xattrs.
        # The sandbox bind-mounts the post's real /dev, and Spotify does not need
        # file capabilities, so omitting both is correct for an unprivileged
        # extraction. -no-exit-code ignores only non-fatal placeholder errors;
        # corrupt archives and other fatal extraction errors still stop here.
        run(['unsquashfs', '-no-progress', '-no-xattrs', '-no-exit-code',
             '-d', unpack, snap])
        complete.write_text('Unprivileged extraction completed without xattrs/devices\n')
    if not unpack.is_dir() or unpack.is_symlink():
        raise RuntimeError(f'Unexpected {name} snap extraction')
    validate_snap_tree(unpack, allow_external_links=True)
    snap_yaml = unpack / 'meta/snap.yaml'
    if not snap_yaml.is_file():
        raise RuntimeError(f'{name} snap metadata is missing')
    text = snap_yaml.read_text()
    declared = re.search(r'^name:\s*([^#\n]+)', text, re.MULTILINE)
    version = re.search(r'^version:\s*([^#\n]+)', text, re.MULTILINE)
    declared = yaml_scalar(declared.group(1)) if declared else ''
    version = yaml_scalar(version.group(1)) if version else ''
    if declared != name or not re.fullmatch(r'[0-9A-Za-z.+_~-]+', version):
        raise RuntimeError(f'Unexpected {name} snap name/version')
    revision = fields['snap-revision']
    release_name = f'{version}-snap-r{revision}'
    destination = safe(root / 'apps/snap-runtimes' / name / 'releases' / release_name)
    metadata = {
        'backend': 'official-snap-runtime', 'name': name, 'version': version,
        'revision': revision, 'snap_id': expected_id, 'sha3_384': actual_sha3,
        'size': int(fields['snap-size']),
    }
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        receipt = destination / '.thin-client-install.json'
        if not receipt.is_file() or json.loads(receipt.read_text()) != metadata:
            raise RuntimeError(f'Existing {name} runtime is incomplete/unrecognized: {destination}')
        print(f'Already installed Spotify runtime: {destination}', flush=True)
    else:
        (unpack / '.thin-client-install.json').write_text(json.dumps(metadata, indent=2) + '\n')
        unpack.rename(destination)
        print(f'Installed Spotify runtime {name} {version}: {destination}', flush=True)
    switch(root / 'apps/snap-runtimes' / name / 'current', destination)
    return destination

def install_spotify(root, work=None):
    """Download and extract Spotify's verified official stable Snap without sudo."""
    if os.uname().machine != 'x86_64':
        raise RuntimeError('Spotify official client currently supports Linux x86_64 here')
    for command in ('snap', 'unsquashfs'):
        if not shutil.which(command):
            raise RuntimeError(f'{command} is required to install the official Spotify Snap')
    if (root / 'apps/spotify/current').exists():
        stopped(('spotify',))
    scratch = safe(root / 'tmp')
    scratch.mkdir(parents=True, exist_ok=True)
    if work is None:
        # A failed unprivileged extraction leaves verified downloads in place.
        # Resume the newest incomplete staging directory, while successful runs
        # are marked complete so a later prepare can discover a newer release.
        retained = sorted(
            (item for item in scratch.glob('spotify-download-*')
             if item.is_dir() and not item.is_symlink() and
             not (item / '.thin-client-install-complete').exists() and
             (item / 'spotify.snap').is_file() and
             (item / 'spotify.assert').is_file()),
            key=lambda item: item.stat().st_mtime_ns, reverse=True)
        work = retained[0] if retained else Path(
            tempfile.mkdtemp(prefix='spotify-download-', dir=scratch))
    safe(work)
    print(f'Spotify download staging (retained on success/failure): {work}', flush=True)
    snap = work / 'spotify.snap'
    assertion = work / 'spotify.assert'
    if not snap.is_file() or not assertion.is_file():
        run(['snap', 'download', 'spotify', '--stable', '--basename=spotify',
             f'--target-directory={work}'])
    fields = spotify_assertion(assertion)
    if snap.stat().st_size != int(fields['snap-size']):
        raise RuntimeError('Spotify snap size differs from its Store assertion')
    actual_sha3 = sha3_384_file(snap)
    if actual_sha3 != fields['snap-sha3-384']:
        raise RuntimeError('Spotify snap hash differs from its Store assertion')
    unpack = work / 'spotify-unpacked'
    if not unpack.exists():
        run(['unsquashfs', '-no-progress', '-d', unpack, snap])
    if not unpack.is_dir() or unpack.is_symlink():
        raise RuntimeError('Unexpected Spotify snap extraction')
    validate_snap_tree(unpack)
    parsed = spotify_snap_metadata(unpack / 'meta/snap.yaml')
    revision = fields['snap-revision']
    release_name = f'{parsed["version"]}-snap-r{revision}'
    destination = safe(root / 'apps/spotify/releases' / release_name)
    metadata = {
        'backend': 'official-spotify-snap', 'version': parsed['version'],
        'revision': revision, 'snap_id': SPOTIFY_SNAP_ID,
        'sha3_384': actual_sha3, 'size': int(fields['snap-size']),
        'base': parsed['base'], 'command': parsed['command'],
        'command_chain': parsed['command_chain'],
    }
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        existing = destination / '.thin-client-install.json'
        existing_metadata = json.loads(existing.read_text()) if existing.is_file() else {}
        immutable_keys = ('backend', 'version', 'revision', 'snap_id',
                          'sha3_384', 'size', 'base')
        if (not existing.is_file() or
                any(existing_metadata.get(key) != metadata.get(key)
                    for key in immutable_keys)):
            raise RuntimeError(f'Existing Spotify release is incomplete/unrecognized: {destination}')
        if existing_metadata != metadata:
            temporary = existing.with_name('.thin-client-install.json.pending')
            temporary.write_text(json.dumps(metadata, indent=2) + '\n')
            os.replace(temporary, existing)
            print(f'Repaired Spotify launch metadata: {existing}', flush=True)
        print(f'Already installed: {destination}', flush=True)
    else:
        (unpack / '.thin-client-install.json').write_text(json.dumps(metadata, indent=2) + '\n')
        spotify_launch(root, unpack, metadata)
        ensure_spotify_mountpoints(unpack)
        unpack.rename(destination)
        print(f'Installed official Spotify {parsed["version"]}: {destination}', flush=True)
    switch(root / 'apps/spotify/current', destination)
    print(f'Activated: {root / "apps/spotify/current"} -> {destination}', flush=True)
    runtimes = {name: install_snap_runtime(root, name, work)
                for name in SPOTIFY_RUNTIME_SNAP_IDS}
    # Seed snap.yaml layout targets while goinfre is known to be writable.
    # Later launches can then work from school posts that expose it read-only.
    ensure_spotify_mountpoints(destination)
    spotify_layout_mounts(runtimes['core24'], runtimes['gnome-46-2404'],
                          runtimes['mesa-2404'])
    (work / '.thin-client-install-complete').write_text(
        'All Spotify application and runtime releases activated\n')

def managed_shell_block(path, name, body):
    """Append or replace one exact managed block without touching other shell setup."""
    safe(path)
    begin = f'# >>> thin-client {name} >>>'
    end = f'# <<< thin-client {name} <<<'
    original = path.read_text() if path.exists() else ''
    if original.count(begin) != original.count(end) or original.count(begin) > 1:
        raise RuntimeError(f'Malformed managed shell block in {path}')
    block = f'{begin}\n{body.rstrip()}\n{end}'
    if begin in original:
        start = original.index(begin)
        finish = original.index(end, start) + len(end)
        contents = original[:start] + block + original[finish:]
    else:
        separator = '' if not original or original.endswith('\n\n') else ('\n' if original.endswith('\n') else '\n\n')
        contents = original + separator + block + '\n'
    if contents == original:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name + '-', dir=path.parent)
    with os.fdopen(fd, 'w') as stream:
        stream.write(contents)
    os.chmod(temporary, mode)
    os.replace(temporary, path)
    print(f'Updated managed {name} block: {path}', flush=True)

def install_pyenv_shell(root):
    """Repair the school pyenv PATH ordering and prefer the managed installation."""
    managed = Path(root) / 'apps/pyenv'
    cache = Path(root) / 'cache/pyenv'
    body = f'''# Keep this after school/Oh My Zsh PATH assignments.
_thin_client_pyenv_root={shlex.quote(str(managed))}
if [ ! -x "$_thin_client_pyenv_root/bin/pyenv" ] && [ -x /opt/pyenv/bin/pyenv ]; then
  _thin_client_pyenv_root=/opt/pyenv
fi
# The school zshenv/profile initializes /opt/pyenv-virtualenv before user
# startup files. When the managed core-only pyenv is available, detach that
# old prompt hook and its shims so it cannot call the missing `sh-activate`.
if [ "$_thin_client_pyenv_root" != /opt/pyenv ]; then
  if [ -n "${{ZSH_VERSION:-}}" ]; then
    precmd_functions=("${{precmd_functions[@]:#_pyenv_virtualenv_hook}}")
    unfunction _pyenv_virtualenv_hook 2>/dev/null || true
  fi
  if [ -n "${{BASH_VERSION:-}}" ]; then
    PROMPT_COMMAND="${{PROMPT_COMMAND//_pyenv_virtualenv_hook;/}}"
    PROMPT_COMMAND="${{PROMPT_COMMAND//_pyenv_virtualenv_hook/}}"
    unset -f _pyenv_virtualenv_hook 2>/dev/null || true
  fi
  unset PYENV_VIRTUALENV_INIT _PYENV_VH_PWD _PYENV_VH_VERSION
  unset _PYENV_VH_VENV _PYENV_VH_PATHS _PYENV_VH_MTIMES
  _thin_client_clean_path=
  _thin_client_old_ifs=$IFS
  IFS=:
  for _thin_client_path in $PATH; do
    case "$_thin_client_path" in
      /opt/pyenv|/opt/pyenv/*) ;;
      *) _thin_client_clean_path="${{_thin_client_clean_path:+$_thin_client_clean_path:}}$_thin_client_path" ;;
    esac
  done
  IFS=$_thin_client_old_ifs
  PATH=$_thin_client_clean_path
  export PATH
  unset _thin_client_clean_path _thin_client_old_ifs _thin_client_path
fi
if [ -x "$_thin_client_pyenv_root/bin/pyenv" ]; then
  export PYENV_ROOT="$_thin_client_pyenv_root"
  export PYTHON_BUILD_CACHE_PATH={shlex.quote(str(cache))}
  export PATH="$PYENV_ROOT/bin:$PYENV_ROOT/shims:$PATH"
  eval "$("$PYENV_ROOT/bin/pyenv" init - --no-rehash)"
fi
unset _thin_client_pyenv_root'''
    # The account uses zsh, while bash remains useful for noninteractive school tooling.
    for path in (HOME / '.zshrc', HOME / '.bashrc'):
        managed_shell_block(path, 'pyenv', body)

def install_pyenv(root, work):
    """Install an immutable pyenv release in goinfre and integrate user shells."""
    appdir = safe(root / 'apps/pyenv')
    releases = safe(appdir / 'releases')
    destination = safe(releases / PYENV_VERSION)
    releases.mkdir(parents=True, exist_ok=True)
    receipt_name = '.thin-client-pyenv.json'

    def validate(path):
        required = [path / 'bin/pyenv', path / 'libexec/pyenv',
                    path / 'plugins/python-build/bin/python-build']
        if not all(candidate.is_file() and os.access(candidate, os.X_OK)
                   for candidate in required):
            raise RuntimeError(f'Incomplete pyenv release: {path}')
        version_file = path / 'libexec/pyenv---version'
        if (not version_file.is_file() or
                f'version="{PYENV_VERSION}"' not in version_file.read_text()):
            raise RuntimeError(f'Unexpected pyenv version metadata: {path}')

    if destination.exists():
        receipt = destination / receipt_name
        metadata = json.loads(receipt.read_text()) if receipt.is_file() else {}
        if metadata != {'version': PYENV_VERSION, 'commit': PYENV_COMMIT}:
            raise RuntimeError(f'Existing pyenv release is unmanaged: {destination}')
        validate(destination)
        print(f'Already installed: {destination}', flush=True)
    else:
        archive = work / 'pyenv.tar.gz'
        fetch(f'https://github.com/pyenv/pyenv/archive/{PYENV_COMMIT}.tar.gz', archive)
        unpack = work / 'pyenv-unpacked'
        unpack.mkdir(mode=0o700)
        extract(archive, unpack, 'tar')
        children = list(unpack.iterdir())
        if len(children) != 1 or not children[0].is_dir():
            raise RuntimeError('Unexpected pyenv archive layout')
        validate(children[0])
        (children[0] / receipt_name).write_text(json.dumps({
            'version': PYENV_VERSION, 'commit': PYENV_COMMIT}, indent=2) + '\n')
        children[0].rename(destination)
        print(f'Installed pinned pyenv {PYENV_VERSION}: {destination}', flush=True)
    switch(appdir / 'current', destination)
    for directory in ('versions', 'shims', 'cache'):
        safe(appdir / directory).mkdir(parents=True, exist_ok=True)
    # PYENV_ROOT remains the stable app directory. Only pyenv's program files
    # follow current; installed Python versions and shims survive pyenv updates.
    for name in ('bin', 'libexec', 'plugins', 'pyenv.d', 'completions'):
        link = appdir / name
        target = Path('current') / name
        if link.is_symlink():
            if os.readlink(link) != str(target):
                raise RuntimeError(f'Unexpected pyenv program link: {link}')
        elif link.exists():
            raise RuntimeError(f'Existing data blocks managed pyenv link: {link}')
        else:
            link.symlink_to(target)
    install_pyenv_shell(root)
    print(f'Activated pyenv {PYENV_VERSION}; Python versions: {appdir / "versions"}', flush=True)

def install(root):
    if os.uname().machine != 'x86_64':
        raise RuntimeError('This release currently supports Linux x86_64 only')
    # First installation cannot affect running Flatpak applications. Updates
    # refuse activation until applications are stopped; old releases are retained.
    if any((root / 'apps' / app / 'current').exists() for app in ['brave', 'vscode']):
        stopped()
    safe(root / 'tmp').mkdir(parents=True, exist_ok=True)
    work = Path(tempfile.mkdtemp(prefix='download-', dir=root / 'tmp'))
    print(f'Download staging (retained on success/failure): {work}', flush=True)
    version = text_url('https://versions.brave.com/latest/release-linux-x64.version', work, 'brave-version')
    if not re.fullmatch(r'\d+\.\d+\.\d+', version):
        raise RuntimeError('Invalid Brave stable version')
    # Protect existing profile from an accidental Brave version downgrade.
    for profile in (OLD_BRAVE, BRAVE):
        last = profile / 'Last Version'
        if last.exists():
            parts = last.read_text().strip().split('.')[-3:]
            if tuple(map(int, version.split('.'))) < tuple(map(int, parts)):
                raise RuntimeError('Latest downloaded Brave would downgrade an existing profile')
    url = f'https://github.com/brave/brave-browser/releases/download/v{version}/brave-browser-{version}-linux-amd64.zip'
    sha = text_url(url + '.sha256', work, 'brave-sha256').split()[0]
    meta = json.loads(text_url('https://update.code.visualstudio.com/api/update/linux-x64/stable/latest', work, 'vscode-meta.json'))
    install_app(root, 'brave', version, url, sha, 'zip', work)
    install_app(root, 'vscode', meta['productVersion'], meta['url'], meta['sha256hash'], 'tar', work)
    install_spotify(root, work)
    install_pyenv(root, work)
    install_coding_clis(root, work)

def confined_executable(path, directory):
    """Return an executable only when its resolved target remains in directory."""
    if not path.exists() or not os.access(path, os.X_OK):
        raise RuntimeError(f'Missing executable: {path}')
    resolved = path.resolve()
    if not resolved.is_relative_to(directory.resolve()):
        raise RuntimeError(f'Executable escapes its managed goinfre directory: {path}')
    return resolved

def compatibility_launcher(name, launcher):
    """Expose a managed ~/.local/bin launcher through school images' ~/bin."""
    compatibility = HOME / 'bin' / name
    compatibility.parent.mkdir(parents=True, exist_ok=True)
    managed_file(compatibility,
                 '#!/bin/sh\n# Managed by thin-client-setup\n'
                 f'exec {shlex.quote(str(launcher))} "$@"\n', 0o755)

def cli_wrapper(name):
    """Install a small persistent launcher; preserve unrelated user commands."""
    path = HOME / '.local/bin' / name
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        target = path.resolve(strict=False)
        official = (HOME / ('.codex/packages/standalone' if name == 'codex'
                            else '.local/share/claude/versions')).resolve()
        if not target.is_relative_to(official):
            raise RuntimeError(f'Refusing to replace unrelated command link: {path} -> {target}')
        path.unlink()
        print(f'Replaced recognized official {name} launcher; its old package files were retained',
              flush=True)
    managed_file(path,
                 '#!/bin/sh\n# Managed by thin-client-setup\n'
                 f'exec {shlex.quote(str(SELF))} open {name} "$@"\n', 0o755)
    # Some school images reset PATH after login and omit ~/.local/bin, while
    # retaining ~/bin as their first entry.  Keep the real managed launcher in
    # ~/.local/bin and add the same tiny shim in the already-supported ~/bin.
    compatibility_launcher(name, path)

def verify_claude_manifest(work, manifest, signature):
    """Verify Anthropic's signed manifest with an isolated temporary keyring."""
    key = work / 'claude-code.asc'
    fetch('https://downloads.claude.ai/keys/claude-code.asc', key)
    gnupg = work / 'gnupg'
    gnupg.mkdir(mode=0o700)
    run(['gpg', '--batch', '--homedir', gnupg, '--import', key],
        capture_output=True, text=True)
    listing = run(['gpg', '--batch', '--homedir', gnupg, '--with-colons',
                   '--fingerprint', 'security@anthropic.com'], capture_output=True, text=True)
    fingerprints = [line.split(':')[9].upper() for line in listing.stdout.splitlines()
                    if line.startswith('fpr:') and len(line.split(':')) > 9]
    if CLAUDE_SIGNING_FINGERPRINT not in fingerprints:
        raise RuntimeError('Anthropic release signing-key fingerprint did not match')
    run(['gpg', '--batch', '--homedir', gnupg, '--verify', signature, manifest],
        capture_output=True, text=True)
    print('Verified Anthropic signature on Claude Code release manifest', flush=True)

def install_claude(root, work):
    base = 'https://downloads.claude.ai/claude-code-releases'
    version = text_url(base + '/latest', work, 'claude-version')
    if not re.fullmatch(r'\d+\.\d+\.\d+', version):
        raise RuntimeError('Invalid Claude Code version')
    manifest_path = work / 'claude-manifest.json'
    signature = work / 'claude-manifest.json.sig'
    fetch(f'{base}/{version}/manifest.json', manifest_path)
    fetch(f'{base}/{version}/manifest.json.sig', signature)
    verify_claude_manifest(work, manifest_path, signature)
    manifest = json.loads(manifest_path.read_text())
    platform = manifest.get('platforms', {}).get('linux-x64', {})
    checksum = platform.get('checksum', '')
    if not re.fullmatch(r'[0-9a-fA-F]{64}', checksum):
        raise RuntimeError('Claude manifest has no valid linux-x64 checksum')
    appdir = safe(root / 'apps/claude')
    releases = safe(appdir / 'releases')
    dest = safe(releases / version)
    releases.mkdir(parents=True, exist_ok=True)
    if dest.exists():
        receipt = json.loads((dest / '.thin-client-install.json').read_text())
        if receipt.get('sha256') != checksum.lower():
            raise RuntimeError(f'Existing Claude release is unrecognized: {dest}')
        confined_executable(dest / 'claude', dest)
        print(f'Already installed: {dest}', flush=True)
    else:
        download = work / 'claude'
        fetch(f'{base}/{version}/linux-x64/claude', download)
        verify_checksum(download, checksum)
        if isinstance(platform.get('size'), int) and download.stat().st_size != platform['size']:
            raise RuntimeError('Claude binary size does not match signed manifest')
        stage = work / 'claude-unpacked'
        stage.mkdir(mode=0o700)
        binary = stage / 'claude'
        download.replace(binary)
        binary.chmod(0o755)
        (stage / '.thin-client-install.json').write_text(json.dumps({
            'version': version, 'sha256': checksum.lower(),
            'url': f'{base}/{version}/linux-x64/claude'}, indent=2) + '\n')
        stage.rename(dest)
        print(f'Installed new release: {dest}', flush=True)
    switch(appdir / 'current', dest)
    print(f'Activated: {appdir / "current"} -> {dest}', flush=True)

def install_codex(root, work):
    """Run OpenAI's official installer with both package roots confined to goinfre."""
    appdir = safe(root / 'apps/codex')
    package_home = safe(appdir / 'installer-home')
    bindir = safe(appdir / 'bin')
    package_home.mkdir(parents=True, exist_ok=True)
    bindir.mkdir(parents=True, exist_ok=True)
    installer = work / 'codex-install.sh'
    fetch('https://chatgpt.com/codex/install.sh', installer)
    env = dict(os.environ)
    env.update({'CODEX_HOME': str(package_home), 'CODEX_INSTALL_DIR': str(bindir),
                'CODEX_NON_INTERACTIVE': '1'})
    cli_stopped('codex')
    run(['/bin/sh', installer], env=env)
    executable = confined_executable(bindir / 'codex', appdir)
    daemon = package_home / 'packages/app-server-daemon/current/bin/codex'
    if not os.access(daemon, os.X_OK):
        run([executable, 'app-server', 'daemon', 'start'], env=env)
        if not os.access(daemon, os.X_OK):
            raise RuntimeError('Official Codex installer did not provision the app-server daemon')
        run([executable, 'app-server', 'daemon', 'stop'], env=env)
        print(f'Provisioned Codex app-server daemon: {daemon}', flush=True)
    print(f'Installed/updated Codex CLI packages in disposable storage: {appdir}', flush=True)

def cli_stopped(name):
    """Refuse package relocation while this user's CLI processes are running."""
    r = run(['ps', '-eo', 'uid=,pid=,comm='], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        fields = line.split()
        if (len(fields) == 3 and fields[0] == str(os.getuid()) and
                fields[2].lower().startswith(name)):
            raise RuntimeError(f'Quit every {name} process before relocating packages: '
                               f'{fields[2]} PID {fields[1]}')

def copy_codex_runtime_packages(source, target):
    """Copy non-standalone runtime packages and verify them before activation."""
    run(['rsync', '-a', '--exclude=/standalone/', str(source) + '/', str(target) + '/'])
    verify = run(['rsync', '-anc', '--itemize-changes', '--exclude=/standalone/',
                  str(source) + '/', str(target) + '/'], capture_output=True, text=True)
    if verify.stdout.strip():
        raise RuntimeError('Codex runtime-package verification failed')

def relocate_codex_packages(root):
    """Keep Codex state in HOME but redirect its reproducible packages to goinfre."""
    state = safe(HOME / '.codex')
    state.mkdir(mode=0o700, parents=True, exist_ok=True)
    source = state / 'packages'
    target = safe(root / 'apps/codex/installer-home/packages')
    target.mkdir(parents=True, exist_ok=True)
    if source.is_symlink():
        if source.resolve() != target.resolve():
            raise RuntimeError(f'Unexpected Codex package link: {source} -> {source.resolve()}')
        daemon = target / 'app-server-daemon/current/bin/codex'
        if not os.access(daemon, os.X_OK):
            candidates = sorted((root / 'legacy-backups').glob(
                'codex-packages-*/app-server-daemon'), reverse=True)
            if not candidates:
                raise RuntimeError('Codex daemon package is missing and no recovery copy was found')
            cli_stopped('codex')
            copy_codex_runtime_packages(candidates[0].parent, target)
            if not os.access(daemon, os.X_OK):
                raise RuntimeError('Recovered Codex daemon package is not executable')
            print(f'Restored Codex daemon package from {candidates[0].parent}', flush=True)
        return
    if not source.exists():
        source.symlink_to(target)
        print(f'Linked disposable Codex packages: {source} -> {target}', flush=True)
        return
    if not source.is_dir() or source.is_mount():
        raise RuntimeError(f'Codex packages must be a real unmounted directory: {source}')
    cli_stopped('codex')
    backups = safe(root / 'legacy-backups')
    backups.mkdir(parents=True, exist_ok=True)
    backup = Path(tempfile.mkdtemp(prefix=f'codex-packages-{time.strftime("%Y%m%d-%H%M%S")}-',
                                   dir=backups))
    run(['rsync', '-a', str(source) + '/', str(backup) + '/'])
    verify = run(['rsync', '-anc', '--itemize-changes',
                  str(source) + '/', str(backup) + '/'], capture_output=True, text=True)
    if verify.stdout.strip():
        raise RuntimeError('Codex package backup verification failed; HOME packages were retained')
    (backup / '.thin-client-codex-package-backup.json').write_text(json.dumps({
        'source': str(source), 'created': time.strftime('%Y-%m-%dT%H:%M:%S%z'),
        'reason': 'reproducible packages relocated from persistent HOME'
    }, indent=2) + '\n')
    copy_codex_runtime_packages(source, target)
    # Only this exact reproducible package tree is removed, after a verified
    # goinfre backup. Auth, configuration, sessions, skills and databases remain.
    safe(source)
    print(f'Removing verified HOME package copy only: {source}', flush=True)
    shutil.rmtree(source)
    source.symlink_to(target)
    print(f'Linked disposable Codex packages: {source} -> {target}; '
          f'temporary recovery copy retained at {backup}', flush=True)

def install_coding_clis(root, work=None, only=None):
    if os.uname().machine != 'x86_64':
        raise RuntimeError('Codex/Claude installation currently supports Linux x86_64 only')
    safe(root / 'tmp').mkdir(parents=True, exist_ok=True)
    if work is None:
        work = Path(tempfile.mkdtemp(prefix='cli-download-', dir=root / 'tmp'))
        print(f'CLI download staging (retained on success/failure): {work}', flush=True)
    selected = [only] if only else ['codex', 'claude']
    if 'codex' in selected:
        install_codex(root, work)
    if 'claude' in selected:
        install_claude(root, work)
    for name in selected:
        state = safe(HOME / ('.codex' if name == 'codex' else '.claude'))
        state.mkdir(mode=0o700, parents=True, exist_ok=True)
        if name == 'codex':
            relocate_codex_packages(root)
        cli_wrapper(name)

def cache_link(path, target, managed_alternates=()):
    safe(path.parent)
    safe(target).mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        if path.resolve() != target.resolve():
            allowed = {Path(candidate).resolve() for candidate in managed_alternates}
            if path.resolve() not in allowed:
                raise RuntimeError(f'Unexpected cache link: {path}')
            path.unlink()
            path.symlink_to(target)
            print(f'Switched disposable cache for this post: {path} -> {target}', flush=True)
    elif path.exists():
        raise RuntimeError(f'Existing data blocks cache redirection (left intact): {path}')
    else:
        safe(path.parent).mkdir(parents=True, exist_ok=True)
        path.symlink_to(target)

def vscode_caches(root):
    safe(CODE)
    storage = runtime_storage(root)
    for name in CODE_CACHES:
        relative = Path('cache/vscode') / name
        cache_link(CODE / name, storage / relative, (
            root / relative, transient_runtime_path() / relative))

def chromium_cache_link(profile_root, path, target, root, managed_alternates=(),
                        storage=None, label='Chromium'):
    """Preserve allowlisted Chromium caches before redirecting exact locations."""
    relative = path.relative_to(profile_root)
    parts = relative.parts
    approved = (relative in BRAVE_ROOT_DISPOSABLE_CACHE_PATHS or
                (len(parts) == 2 and
                 (parts[0] == 'Default' or re.fullmatch(r'Profile [0-9]+', parts[0])) and
                 Path(parts[1]) in (BRAVE_PROFILE_DISPOSABLE_CACHE_PATHS +
                                    BRAVE_LEGACY_PROFILE_CACHE_LINKS)))
    if not approved:
        raise RuntimeError(f'Unapproved {label} cache path (left intact): {path}')
    safe(profile_root)
    safe(path.parent)
    if path.exists() and not path.is_symlink():
        if not path.is_dir() or path.is_mount():
            raise RuntimeError(f'Existing data blocks cache redirection (left intact): {path}; '
                               'only explicitly approved relative cache paths '
                               'may be relocated, and they must be real directories, not mounts')
        if root.name != 'thin-client':
            raise RuntimeError(f'Unexpected thin-client root: {root}')
        validate_goinfre(root.parent, HOME, require_writable=False)
        safe(root)
        safe(target).mkdir(parents=True, exist_ok=True)
        stopped(('brave',))
        safe(path)
        if not path.is_dir() or path.is_symlink() or path.is_mount():
            raise RuntimeError(f'{label} cache changed during stopped check (left intact): {path}')
        # Refuse profile/cache mount escapes, including mounted trees within a cache.
        for parent in [profile_root, *path.parents]:
            if parent == profile_root or profile_root in parent.parents:
                if parent.is_mount():
                    raise RuntimeError(f'Mount in {label} cache path (left intact): {parent}')
        def walk_error(error):
            raise RuntimeError(f'Cannot inspect {label} cache safely '
                               f'(left intact): {error.filename}') from error
        for directory, dirs, _ in os.walk(path, followlinks=False, onerror=walk_error):
            for name in dirs:
                child = Path(directory) / name
                if not child.is_symlink() and child.is_mount():
                    raise RuntimeError(f'Mount inside {label} cache (left intact): {child}')
        backups = safe((storage or root) / 'cache-backups')
        backups.mkdir(parents=True, exist_ok=True)
        backup = Path(tempfile.mkdtemp(prefix=label.lower() + '-', dir=backups)) / path.name
        print(f'Relocating stopped {label} cache: {path} -> {backup}', flush=True)
        # HOME and goinfre are separate filesystems: copy before removing the
        # source. shutil.move preserves nested symlinks and retains the source
        # if copying fails; backups are never automatically pruned.
        shutil.move(str(path), str(backup))
        print(f'Preserved {label} cache: {path} -> {backup}', flush=True)
    cache_link(path, target, managed_alternates)

def brave_cache_link(path, target, root, managed_alternates=(), storage=None):
    """Compatibility wrapper for the normal Brave profile cache policy."""
    return chromium_cache_link(BRAVE, path, target, root, managed_alternates,
                               storage, 'Brave')

def brave_disposable_relative_paths(profile_root):
    """Construct exact paths; inspect only immediate children to find profiles."""
    yield from BRAVE_ROOT_DISPOSABLE_CACHE_PATHS
    if profile_root.is_dir():
        for profile in sorted(profile_root.iterdir()):
            if (profile.name == 'Default' or re.fullmatch(r'Profile [0-9]+', profile.name)) and profile.is_dir():
                for relative in BRAVE_PROFILE_DISPOSABLE_CACHE_PATHS:
                    yield Path(profile.name) / relative
                for relative in BRAVE_LEGACY_PROFILE_CACHE_LINKS:
                    if (profile / relative).is_symlink():
                        yield Path(profile.name) / relative

def brave_copy_excludes(profile_root):
    # Leading / anchors each exclusion to the source profile root. Trailing /
    # excludes directories only, preserving unexpected files at those locations.
    return [f'--exclude=/{relative.as_posix()}/'
            for relative in brave_disposable_relative_paths(profile_root)]

def brave_caches(root):
    safe(BRAVE)
    storage = runtime_storage(root)
    if BRAVE.is_dir():
        for relative in brave_disposable_relative_paths(BRAVE):
            cache_relative = Path('cache/brave-profile') / relative
            brave_cache_link(BRAVE / relative, storage / cache_relative, root, (
                root / cache_relative, transient_runtime_path() / cache_relative), storage)

