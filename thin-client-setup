def repair_spotify_login(root):
    """Archive one unwanted login and its cache, leaving a clean sign-in state."""
    stopped(('spotify',))
    if not (SPOTIFY / '.thin-client-import').is_file():
        raise RuntimeError('Spotify profile is not managed; run spotify prepare first')
    safe(SPOTIFY)
    backups = safe(root / 'legacy-backups')
    backups.mkdir(parents=True, exist_ok=True)
    destination = Path(tempfile.mkdtemp(
        prefix=time.strftime('spotify-login-%Y%m%d-%H%M%S-'), dir=backups))
    sources = (
        (SPOTIFY / '.config/spotify', destination / 'spotify-config'),
        (SPOTIFY / '.config/spotify~', destination / 'spotify-config-legacy'),
        (SPOTIFY / '.local/share/keyrings', destination / 'isolated-keyrings'),
        (safe(root / 'cache/spotify'), destination / 'spotify-cache'),
    )
    moved = False
    for source, target in sources:
        if source.exists() or source.is_symlink():
            safe(source)
            shutil.move(str(source), str(target))
            moved = True
    if not moved:
        destination.rmdir()
        print('Spotify already has a clean sign-in state.', flush=True)
        return
    spotify_caches(root)
    print(f'Archived the previous Spotify login/cache: {destination}', flush=True)
    print('Spotify will request a fresh login on its next launch.', flush=True)

