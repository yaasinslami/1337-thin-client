def migrate_brave(stage):
    safe(OLD_BRAVE)
    if not (OLD_BRAVE / 'Local State').is_file():
        raise RuntimeError('Flatpak Brave source exists but lacks Local State')
    excludes = brave_copy_excludes(OLD_BRAVE)
    excludes += ['--exclude=Singleton*', '--exclude=*.lock', '--exclude=*.sock',
                 '--exclude=.org.chromium.*', '--exclude=.thin-client-import']
    dry = run(['rsync', '-an', '--stats', *excludes, str(OLD_BRAVE) + '/', str(stage) + '/'],
              capture_output=True, text=True)
    size = int(re.search(r'Total file size: ([\d,]+) bytes', dry.stdout).group(1).replace(',', ''))
    free = shutil.disk_usage(HOME).free
    print(f'Brave copy: {OLD_BRAVE} -> {BRAVE}; bytes={size}; HOME free={free}', flush=True)
    if free < size + 200 * 1024**2:
        raise RuntimeError('Insufficient HOME space for profile copy plus 200 MiB reserve')
    BRAVE.parent.mkdir(parents=True, exist_ok=True)
    run(['rsync', '-a', *excludes, str(OLD_BRAVE) + '/', str(stage) + '/'])
    # Check copied persistent files by content, not just time/size.
    check = run(['rsync', '-anc', '--itemize-changes', *excludes,
                 str(OLD_BRAVE) + '/', str(stage) + '/'], capture_output=True, text=True)
    if check.stdout.strip():
        raise RuntimeError('Profile copy changed/failed verification; partial copy retained')
    stage.chmod(0o700)
    (stage / '.thin-client-import').write_text(f'Copied from {OLD_BRAVE}\n')
    stage.rename(BRAVE)
    print('Brave persistent copy verified; Flatpak source untouched', flush=True)
def migrate_code():
    safe(OLD_CODE)
    if CODE.exists():
        raise RuntimeError(f'Existing Code-Thin data left intact: {CODE}')
    stage = CODE.with_name('Code-Thin.partial')
    if stage.exists():
        raise RuntimeError(f'Incomplete VS Code migration exists: {stage}')
    user = stage / 'User'
    user.mkdir(parents=True, mode=0o700)
    for name in ['settings.json', 'keybindings.json', 'tasks.json', 'snippets']:
        source = OLD_CODE / name
        if source.is_dir():
            shutil.copytree(source, user / name, symlinks=True)
        elif source.is_file():
            shutil.copy2(source, user / name)
    settings = user / 'settings.json'
    if settings.exists():
        original = settings.read_text()
        data = parse_jsonc(original)
        profiles = data.get('terminal.integrated.profiles.linux', {})
        invalid = [k for k,v in profiles.items() if isinstance(v,dict) and
                   Path(v.get('path','')).name in ['flatpak-spawn','host-spawn']]
        if invalid:
            shutil.copy2(settings, STATE / 'flatpak-vscode-settings.original.jsonc')
            for k in invalid:
                del profiles[k]
            if not profiles:
                data.pop('terminal.integrated.profiles.linux', None)
            if data.get('terminal.integrated.defaultProfile.linux') in invalid:
                data.pop('terminal.integrated.defaultProfile.linux', None)
            settings.write_text(json.dumps(data, indent=2) + '\n')
            print('Removed copied Flatpak-only terminal profile; original settings preserved', flush=True)
    (stage / '.thin-client-import').write_text(f'Copied small preferences from {OLD_CODE}\n')
    stage.chmod(0o700)
    stage.rename(CODE)
    print(f'VS Code small preferences: {OLD_CODE} -> {CODE / "User"}', flush=True)

def environment(root, app):
    env = dict(os.environ)
    storage = runtime_storage(root)
    env['XDG_CONFIG_HOME'] = str(HOME / '.config')
    env['XDG_DATA_HOME'] = str(HOME / '.local/share')
    env['XDG_CACHE_HOME'] = str(storage / 'cache' / app)
    env['TMPDIR'] = str(storage / 'tmp')
    paths = [storage / 'cache' / app, storage / 'tmp']
    if app == 'vscode':
        # xdg-open's generic fallback can honor BROWSER. Use desktop handlers
        # for native Code, without forcing a browser or changing the shell.
        env.pop('BROWSER', None)
        extensions = vscode_extensions()
        extensions.mkdir(parents=True, exist_ok=True)
    for p in paths:
        safe(p).mkdir(parents=True, exist_ok=True)
    return env

def code_args(root):
    return [root / 'apps/vscode/current/bin/code', '--user-data-dir', CODE,
            '--extensions-dir', vscode_extensions()]

def gpu_render_available():
    """Only claim hardware acceleration when a usable DRM render node exists."""
    dri = Path('/dev/dri')
    if not dri.is_dir():
        return False
    return any(candidate.is_char_device() and os.access(candidate, os.R_OK | os.W_OK)
               for candidate in dri.glob('renderD*'))

def gpu_args():
    if not gpu_render_available():
        return []
    return ['--ignore-gpu-blocklist', '--enable-gpu-rasterization', '--enable-zero-copy']

def islands_dark_source(root):
    """Fetch and validate the pinned upstream theme without running its scripts."""
    sources = safe(STATE / 'theme-sources/islands-dark')
    source = safe(sources / ISLANDS_DARK_COMMIT)

    def validate(path):
        package_path = path / 'package.json'
        settings_path = path / 'settings.json'
        theme_path = path / 'themes/islands-dark.json'
        if not all(p.is_file() for p in [package_path, settings_path, theme_path]):
            raise RuntimeError(f'Incomplete Islands Dark source: {path}')
        package = json.loads(package_path.read_text())
        expected = ('bwya77', 'islands-dark', ISLANDS_DARK_VERSION)
        actual = (package.get('publisher'), package.get('name'), package.get('version'))
        themes = package.get('contributes', {}).get('themes', [])
        if actual != expected or not any(t.get('label') == 'Islands Dark' and
                                         t.get('path') == './themes/islands-dark.json'
                                         for t in themes if isinstance(t, dict)):
            raise RuntimeError('Unexpected Islands Dark extension metadata')
        parse_jsonc(settings_path.read_text())
        return package

    def persist(candidate):
        """Copy through HOME so final activation never crosses filesystems."""
        validate(candidate)
        pending = Path(tempfile.mkdtemp(prefix=f'.{ISLANDS_DARK_COMMIT}-', dir=sources))
        try:
            shutil.copytree(candidate, pending, dirs_exist_ok=True, symlinks=True)
            validate(pending)
            pending.rename(source)
        except Exception:
            if pending.exists():
                shutil.rmtree(pending)
            raise
        print(f'Installed pinned Islands Dark source: {source}', flush=True)
        return source

    if source.exists():
        validate(source)
        return source
    sources.mkdir(parents=True, exist_ok=True)
    scratch = safe(runtime_storage(root) / 'tmp')
    scratch.mkdir(parents=True, exist_ok=True)
    # A previous run may have downloaded and validated the archive but failed
    # while activating it. Reuse that retained staging instead of downloading.
    retained_roots = [scratch]
    root_scratch = Path(root) / 'tmp'
    if root_scratch.is_dir() and root_scratch.resolve() != scratch.resolve():
        retained_roots.append(root_scratch)
    retained = sorted(candidate for directory in retained_roots for candidate in directory.glob(
        f'islands-dark-*/unpacked/vscode-dark-islands-{ISLANDS_DARK_COMMIT}'))
    for candidate in reversed(retained):
        try:
            validate(candidate)
        except (OSError, RuntimeError, json.JSONDecodeError):
            continue
        return persist(candidate)
    work = Path(tempfile.mkdtemp(prefix='islands-dark-', dir=scratch))
    archive = work / 'source.tar.gz'
    url = ('https://github.com/bwya77/vscode-dark-islands/archive/'
           f'{ISLANDS_DARK_COMMIT}.tar.gz')
    fetch(url, archive)
    unpack = work / 'unpacked'
    unpack.mkdir(mode=0o700)
    extract(archive, unpack, 'tar')
    children = list(unpack.iterdir())
    if len(children) != 1 or not children[0].is_dir():
        raise RuntimeError('Unexpected Islands Dark archive layout')
    return persist(children[0])

def install_islands_dark_files(root, source):
    """Install the unpacked color theme, fonts and Code-Thin settings."""
    extension_root = vscode_extensions()
    extension_root.mkdir(parents=True, exist_ok=True)
    destination = safe(extension_root / f'bwya77.islands-dark-{ISLANDS_DARK_VERSION}')
    receipt_name = '.thin-client-islands-dark.json'
    install_extension = True
    if destination.exists():
        receipt = destination / receipt_name
        try:
            installed = json.loads(receipt.read_text()) if receipt.is_file() else {}
        except (OSError, json.JSONDecodeError):
            installed = {}
        if (installed.get('repository') !=
                'https://github.com/bwya77/vscode-dark-islands' or
                installed.get('version') != ISLANDS_DARK_VERSION or
                installed.get('commit') not in ISLANDS_DARK_MANAGED_COMMITS):
            raise RuntimeError(f'Existing Islands Dark extension is unmanaged: {destination}')
        install_extension = installed.get('commit') != ISLANDS_DARK_COMMIT
    if install_extension:
        # Stage beside the final extension so activation remains an atomic HOME
        # rename even when scratch storage is on goinfre or /tmp.
        stage = Path(tempfile.mkdtemp(prefix='.islands-extension-', dir=extension_root))
        shutil.copy2(source / 'package.json', stage / 'package.json')
        shutil.copytree(source / 'themes', stage / 'themes')
        if (source / 'icon.png').is_file():
            shutil.copy2(source / 'icon.png', stage / 'icon.png')
        (stage / receipt_name).write_text(json.dumps({
            'repository': 'https://github.com/bwya77/vscode-dark-islands',
            'commit': ISLANDS_DARK_COMMIT,
            'version': ISLANDS_DARK_VERSION,
        }, indent=2) + '\n')
        # Only a receipt from one of our immutable earlier revisions reaches
        # this branch. The extension is reproducible; persistent settings are
        # separate and are not removed here.
        if destination.exists():
            shutil.rmtree(destination)
        stage.rename(destination)
        print(f'Installed/updated Islands Dark extension: {destination}', flush=True)

    # VS Code regenerates this cache; preserve the pre-theme copy once, then
    # remove the stale inventory so the manually installed theme is discovered.
    inventory = extension_root / 'extensions.json'
    if inventory.exists():
        if not inventory.is_file() or inventory.is_symlink():
            raise RuntimeError(f'Unexpected VS Code extension inventory: {inventory}')
        backup = STATE / 'extensions.pre-islands-dark.json'
        if not backup.exists():
            shutil.copy2(inventory, backup)
        inventory.unlink()

    fonts = safe(STATE / 'fonts/islands-dark')
    fonts.mkdir(parents=True, exist_ok=True)
    fonts_changed = False
    for font in sorted((source / 'fonts').glob('*.otf')):
        target = fonts / font.name
        if not target.exists() or digest(target) != digest(font):
            temporary = target.with_name('.' + target.name + '.pending')
            shutil.copy2(font, temporary)
            os.replace(temporary, target)
            fonts_changed = True
    fontconfig = HOME / '.config/fontconfig/conf.d/50-thin-client-islands-dark.conf'
    safe(fontconfig.parent).mkdir(parents=True, exist_ok=True)
    escaped_fonts = (str(fonts).replace('&', '&amp;').replace('<', '&lt;')
                     .replace('>', '&gt;'))
    fontconfig_contents = ('<?xml version="1.0"?>\n<!-- # Managed by thin-client-setup -->\n'
                           '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">\n'
                           f'<fontconfig><dir>{escaped_fonts}</dir></fontconfig>\n')
    fontconfig_changed = not fontconfig.exists() or fontconfig.read_text() != fontconfig_contents
    managed_file(fontconfig, fontconfig_contents, 0o644)

    settings = CODE / 'User/settings.json'
    safe(settings.parent).mkdir(parents=True, exist_ok=True)
    current = parse_jsonc(settings.read_text()) if settings.exists() else {}
    theme = parse_jsonc((source / 'settings.json').read_text())
    backup = STATE / 'settings.pre-islands-dark.jsonc'
    if settings.exists() and not backup.exists():
        shutil.copy2(settings, backup)
    merged = dict(current)
    merged.update(theme)
    merged.update(ISLANDS_DARK_COMFORT_SETTINGS)
    watcher_excludes = {}
    for configured in (current.get('files.watcherExclude'),
                       theme.get('files.watcherExclude')):
        if isinstance(configured, dict):
            watcher_excludes.update(configured)
    watcher_excludes.update(ISLANDS_DARK_COMFORT_SETTINGS['files.watcherExclude'])
    merged['files.watcherExclude'] = watcher_excludes
    stylesheet = {}
    for configured in (current.get('custom-ui-style.stylesheet'),
                       theme.get('custom-ui-style.stylesheet')):
        if isinstance(configured, dict):
            stylesheet.update(configured)
    stylesheet.update(ISLANDS_DARK_LOW_LATENCY_STYLES)
    merged['custom-ui-style.stylesheet'] = stylesheet
    colors = {}
    for configured in (current.get('workbench.colorCustomizations'),
                       theme.get('workbench.colorCustomizations')):
        if isinstance(configured, dict):
            colors.update(configured)
    islands_colors = colors.get('[Islands Dark]', {})
    islands_colors = dict(islands_colors) if isinstance(islands_colors, dict) else {}
    islands_colors.update(ISLANDS_DARK_COMFORT_COLORS)
    colors['[Islands Dark]'] = islands_colors
    merged['workbench.colorCustomizations'] = colors
    contents = json.dumps(merged, indent=2) + '\n'
    if not settings.exists() or settings.read_text() != contents:
        fd, temporary = tempfile.mkstemp(prefix='.settings-', dir=settings.parent)
        with os.fdopen(fd, 'w') as stream:
            stream.write(contents)
        os.chmod(temporary, 0o600)
        os.replace(temporary, settings)
        print(f'Applied Islands Dark settings (previous copy: {backup})', flush=True)
    if (fonts_changed or fontconfig_changed) and shutil.which('fc-cache'):
        run(['fc-cache', '-f'], env=environment(root, 'vscode'))

def install_vscode_theme(root):
    """Install the complete Islands Dark setup into the managed Code instance."""
    if not (CODE / '.thin-client-import').exists():
        raise RuntimeError('Complete VS Code migration before installing the theme')
    executable = root / 'apps/vscode/current/bin/code'
    if not os.access(executable, os.X_OK):
        raise RuntimeError('VS Code is missing: run thin-client-setup prepare first')
    stopped(('vscode',))
    vscode_caches(root)
    vscode_extensions().mkdir(parents=True, exist_ok=True)
    env = environment(root, 'vscode')
    # Install the requested theme itself before Marketplace companions. This
    # leaves a usable color theme if a school proxy temporarily blocks the
    # Marketplace while GitHub remains reachable; rerunning completes the rest.
    source = islands_dark_source(root)
    install_islands_dark_files(root, source)
    for ext in EXTENSIONS:
        run([*code_args(root), '--install-extension', ext], env=env)
    print('Local extension inventory:', flush=True)
    run([*code_args(root), '--list-extensions', '--show-versions'], env=env)
    print('Islands Dark installed. On first launch run "Custom UI Style: Reload" '
          'from the Command Palette to activate the rounded-panel CSS.', flush=True)

def integrate(root):
    if (not (CODE / '.thin-client-import').exists() or
            not (BRAVE / '.thin-client-import').exists() or
            not (SPOTIFY / '.thin-client-import').exists()):
        raise RuntimeError('Complete migration before integration')
    stopped()
    brave_caches(root)
    spotify_caches(root)
    install_vscode_theme(root)
    desktop_integration(root)

def desktop_icon(root, app):
    """Copy a vendor icon into persistent HOME for cross-post desktop menus."""
    sources = {
        'brave': root / 'apps/brave/current/product_logo_256.png',
        'code': root / 'apps/vscode/current/resources/app/resources/linux/code.png',
    }
    source = sources[app]
    app_root = (root / 'apps' / ('brave' if app == 'brave' else 'vscode')).resolve()
    if (not source.is_file() or source.is_symlink() or
            not source.resolve().is_relative_to(app_root)):
        raise RuntimeError(f'Missing or unexpected {app} desktop icon: {source}')
    icons = safe(STATE / 'icons')
    icons.mkdir(parents=True, exist_ok=True)
    destination = safe(icons / f'{app}-native.png')
    if not destination.exists() or digest(destination) != digest(source):
        temporary = destination.with_name('.' + destination.name + '.pending')
        shutil.copy2(source, temporary)
        temporary.chmod(0o644)
        os.replace(temporary, destination)
        print(f'Installed persistent desktop icon: {destination}', flush=True)
    return destination

def spotify_desktop_icon():
    """Install the requested Spotify artwork into persistent desktop storage."""
    icons = safe(STATE / 'icons')
    icons.mkdir(parents=True, exist_ok=True)
    destination = safe(icons / 'spotify-app.png')
    source = Path(__file__).resolve().parent / 'assets/spotify-icon.png'
    if source.is_file() and not source.is_symlink():
        if digest(source) != SPOTIFY_ICON_SHA256:
            raise RuntimeError(f'Bundled Spotify icon failed checksum validation: {source}')
        if not destination.exists() or digest(destination) != SPOTIFY_ICON_SHA256:
            temporary = destination.with_name('.spotify-app.png.pending')
            shutil.copy2(source, temporary)
            temporary.chmod(0o644)
            os.replace(temporary, destination)
            print(f'Installed persistent Spotify icon: {destination}', flush=True)
    if (not destination.is_file() or destination.is_symlink() or
            digest(destination) != SPOTIFY_ICON_SHA256):
        raise RuntimeError('Spotify icon asset is unavailable; run install-self or prepare '
                           'from the reviewed repository checkout')
    return destination

def spotify_open_helper():
    return safe(STATE / 'helpers/spotify-xdg-open')

def spotify_snapctl_helper():
    return safe(STATE / 'helpers/snapctl')

def install_spotify_open_helper():
    """Install a narrow host-portal bridge for links opened by Spotify."""
    helper = spotify_open_helper()
    helper.parent.mkdir(parents=True, exist_ok=True)
    managed_file(helper,
                 '''#!/bin/sh
# Managed by thin-client-setup
if [ "$#" -ne 1 ]; then
  echo "spotify-xdg-open: expected exactly one URL" >&2
  exit 2
fi
case "$1" in
  http://*|https://*) ;;
  *) echo "spotify-xdg-open: refused non-web URL" >&2; exit 2 ;;
esac
if [ -n "${THIN_CLIENT_OPEN_FIFO:-}" ] && [ -p "$THIN_CLIENT_OPEN_FIFO" ]; then
  printf '%s\n' "$1" > "$THIN_CLIENT_OPEN_FIFO"
  exit $?
fi
echo "spotify-xdg-open: host browser bridge unavailable" >&2
exit 1
''', 0o755)
    return helper

def install_spotify_snapctl_helper():
    """Provide only the connection checks used by the signed desktop chain."""
    helper = spotify_snapctl_helper()
    helper.parent.mkdir(parents=True, exist_ok=True)
    managed_file(helper,
                 '''#!/bin/sh
# Managed by thin-client-setup
if [ "$#" -eq 2 ] && [ "$1" = "is-connected" ]; then
  case "$2" in
    gnome-46-2404|gsettings) exit 0 ;;
  esac
fi
echo "spotify-snapctl: unsupported command" >&2
exit 1
''', 0o755)
    return helper

def spotify_desktop_integration(root, apps=None):
    """Create the isolated Spotify launcher and register only spotify: links."""
    apps = apps or HOME / '.local/share/applications'
    safe(apps).mkdir(parents=True, exist_ok=True)
    safe(HOME / '.local/bin').mkdir(parents=True, exist_ok=True)
    icon = spotify_desktop_icon()
    wrapper = HOME / '.local/bin/spotify'
    managed_file(wrapper,
                 '#!/bin/sh\n# Managed by thin-client-setup\n'
                 f'exec {shlex.quote(str(SELF))} open spotify "$@"\n', 0o755)
    compatibility_launcher('spotify', wrapper)
    native_wrapper = HOME / '.local/bin/spotify-native'
    managed_file(native_wrapper,
                 '#!/bin/sh\n# Managed by thin-client-setup\n'
                 f'exec {shlex.quote(str(wrapper))} "$@"\n', 0o755)
    compatibility_launcher('spotify-native', native_wrapper)
    managed_file(apps / 'spotify-thin.desktop',
                 '[Desktop Entry]\n# Managed by thin-client-setup\n'
                 'Type=Application\nName=Spotify\n'
                 f'Exec="{wrapper}" %U\nIcon={icon}\n'
                 'Categories=Audio;Music;Player;AudioVideo;\n'
                 'StartupWMClass=spotify\nStartupNotify=true\n'
                 'MimeType=x-scheme-handler/spotify;\n', 0o644)
    run(['xdg-mime', 'default', 'spotify-thin.desktop',
         'x-scheme-handler/spotify'], env=xdg_environment())

def install_code_shell():
    """Remove the school/macOS-style zsh function so `code` uses our wrapper."""
    body = '''# The school profile defines a macOS `open -b` function on Linux.
if [ -n "${ZSH_VERSION:-}" ]; then
  unfunction code 2>/dev/null || true
  rehash
fi'''
    managed_shell_block(HOME / '.zshrc', 'native-code', body)

def desktop_integration(root):
    """Write launchers without installing extensions or requiring apps to quit."""
    apps = HOME / '.local/share/applications'
    safe(apps).mkdir(parents=True, exist_ok=True)
    safe(HOME / '.local/bin').mkdir(parents=True, exist_ok=True)
    icons = {app: desktop_icon(root, app) for app in ('brave', 'code')}
    for app, title, command, category in [
        ('brave', 'Brave (native thin client)', 'brave-native', 'Network;WebBrowser;'),
        ('code', 'VS Code (native thin client)', 'code-native', 'Development;IDE;')]:
        wrapper = HOME / '.local/bin' / command
        contents = '#!/bin/sh\n# Managed by thin-client-setup\nexec ' + shlex.quote(str(SELF)) + ' open ' + app + ' "$@"\n'
        managed_file(wrapper, contents, 0o755)
        compatibility_launcher(command, wrapper)
        entry = apps / (command + '.desktop')
        contents = ('[Desktop Entry]\n# Managed by thin-client-setup\nType=Application\n'
                    f'Name={title}\nExec="{wrapper}" ' + ('%U' if app == 'brave' else '%F') + '\n'
                    f'Icon={icons[app]}\nCategories={category}\nStartupWMClass=' + ('brave-native' if app == 'brave' else 'code') + '\n')
        if app == 'brave':
            contents += 'MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;\n'
        managed_file(entry, contents, 0o644)
    wrapper = HOME / '.local/bin/code-native'
    managed_file(apps / 'code-native-url-handler.desktop',
                 '[Desktop Entry]\n# Managed by thin-client-setup\n'
                 'Type=Application\nName=VS Code (native thin client) - URL Handler\n'
                 f'Exec="{wrapper}" --open-url %U\n'
                 f'Icon={icons["code"]}\nNoDisplay=true\nStartupNotify=true\n'
                 'Categories=Development;IDE;\nMimeType=x-scheme-handler/vscode;\n', 0o644)
    # The root-owned school VS Code cannot be uninstalled without sudo. User
    # desktop overrides hide it, while `code` becomes an alias-safe managed
    # wrapper for the native thin-client build.
    for name in ('code.desktop', 'code-url-handler.desktop'):
        managed_file(apps / name,
                     '[Desktop Entry]\n# Managed by thin-client-setup\nHidden=true\n', 0o644)
    code_wrapper = HOME / '.local/bin/code'
    managed_file(code_wrapper,
                 '#!/bin/sh\n# Managed by thin-client-setup\n'
                 f'exec {shlex.quote(str(SELF))} open code "$@"\n', 0o755)
    compatibility_launcher('code', code_wrapper)
    install_code_shell()
    spotify_desktop_integration(root, apps)
    if shutil.which('update-desktop-database'):
        run(['update-desktop-database', apps], env=xdg_environment())
    run(['xdg-mime', 'default', 'code-native-url-handler.desktop', 'x-scheme-handler/vscode'],
        env=xdg_environment())
    print('Launchers installed; system VS Code hidden for this user; Code and Spotify URI '
          'handlers registered; browser default unchanged', flush=True)

def managed_file(path, contents, mode):
    safe(path)
    if (path.exists() and not any('# Managed by thin-client-setup' in line
                                  for line in path.read_text().splitlines())):
        raise RuntimeError(f'Refusing to overwrite unmanaged file: {path}')
    if not path.exists() or path.read_text() != contents:
        fd, temporary = tempfile.mkstemp(prefix='.' + path.name + '-', dir=path.parent)
        with os.fdopen(fd, 'w') as stream:
            stream.write(contents)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
        print(f'Wrote managed file: {path}', flush=True)
    elif stat.S_IMODE(path.stat().st_mode) != mode:
        path.chmod(mode)

def spotify_xauthority():
    """Return the current user's X11 cookie without exposing arbitrary files."""
    raw = os.environ.get('XAUTHORITY') or str(HOME / '.Xauthority')
    candidate = Path(raw)
    if not candidate.is_absolute():
        return None
    try:
        resolved = candidate.resolve(strict=True)
        details = resolved.stat()
    except OSError:
        return None
    runtime = Path('/run/user') / str(os.getuid())
    if (not resolved.is_file() or details.st_uid != os.getuid() or
            not (resolved.is_relative_to(HOME.resolve()) or
                 resolved.is_relative_to(runtime))):
        return None
    return resolved

def spotify_browser_url(value):
    """Validate one URL received from the sandbox before opening it on the host."""
    if not isinstance(value, str) or not value or len(value) > 8192 or '\n' in value or '\r' in value:
        return None
    parsed = urllib.parse.urlsplit(value)
    if parsed.scheme not in ('http', 'https') or not parsed.netloc:
        return None
    return value

def start_spotify_browser_bridge():
    """Fork a private host-side xdg-open relay that lives with Spotify's parent."""
    runtime = Path('/run/user') / str(os.getuid())
    configured = Path(os.environ.get('XDG_RUNTIME_DIR', str(runtime)))
    if configured.resolve() != runtime or not runtime.is_dir() or runtime.stat().st_uid != os.getuid():
        raise RuntimeError('Spotify browser bridge needs the account XDG runtime directory')
    directory = Path(tempfile.mkdtemp(prefix='thin-client-spotify-', dir=runtime))
    directory.chmod(0o700)
    fifo = directory / 'open.fifo'
    os.mkfifo(fifo, 0o600)
    parent = os.getpid()
    try:
        child = os.fork()
    except OSError:
        fifo.unlink(missing_ok=True)
        directory.rmdir()
        raise
    if child:
        return fifo
    # This child remains in the host mount namespace. The parent keeps its PID
    # when it execs bwrap, so getppid() changes only when Spotify really exits.
    try:
        descriptor = os.open(fifo, os.O_RDWR | os.O_NONBLOCK)
        buffered = b''
        while os.getppid() == parent:
            readable, _, _ = select.select([descriptor], [], [], 1.0)
            if not readable:
                continue
            chunk = os.read(descriptor, 16384)
            if not chunk:
                continue
            buffered += chunk
            while b'\n' in buffered:
                line, buffered = buffered.split(b'\n', 1)
                try:
                    url = spotify_browser_url(line.decode('utf-8', errors='strict'))
                except UnicodeDecodeError:
                    url = None
                if url:
                    brave = HOME / '.local/bin/brave-native'
                    managed_brave = (brave.is_file() and not brave.is_symlink() and
                                     os.access(brave, os.X_OK) and
                                     '# Managed by thin-client-setup' in brave.read_text())
                    command = [str(brave), url] if managed_brave else ['/usr/bin/xdg-open', url]
                    subprocess.Popen(command, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     close_fds=True, start_new_session=True)
        os.close(descriptor)
    except BaseException:
        pass
    finally:
        fifo.unlink(missing_ok=True)
        try:
            directory.rmdir()
        except OSError:
            pass
        os._exit(0)

def spotify_environment(root, release, metadata):
    """Recreate the user-visible Snap environment inside the portable runtime."""
    env = environment(root, 'spotify')
    snap_data = SPOTIFY / 'system' / metadata['revision']
    snap_common = SPOTIFY / 'system/common'
    for directory in (SPOTIFY / '.config', SPOTIFY / '.local/share', SPOTIFY / 'common',
                      SPOTIFY / 'common/.cache', SPOTIFY / '.cache', SPOTIFY / '.tmp',
                      snap_data, snap_common):
        safe(directory).mkdir(parents=True, exist_ok=True)
    snap = '/snap/spotify/current'
    session_runtime = f'/run/user/{os.getuid()}'
    snap_runtime = f'{session_runtime}/snap.spotify'
    env.update({
        'HOME': str(SPOTIFY), 'SNAP': snap, 'SNAP_NAME': 'spotify',
        'SNAP_INSTANCE_NAME': 'spotify', 'SNAP_ARCH': 'amd64',
        'SNAP_VERSION': metadata['version'], 'SNAP_REVISION': metadata['revision'],
        'SNAP_DATA': str(snap_data), 'SNAP_COMMON': str(snap_common),
        'SNAP_USER_DATA': str(SPOTIFY), 'SNAP_USER_COMMON': str(SPOTIFY / 'common'),
        'SNAP_REAL_HOME': str(HOME), 'XDG_CONFIG_HOME': str(SPOTIFY / '.config'),
        'XDG_DATA_HOME': str(SPOTIFY / '.local/share'),
        'XDG_CACHE_HOME': str(SPOTIFY / '.cache'), 'TMPDIR': str(SPOTIFY / '.tmp'),
        'SNAP_UID': str(os.getuid()), 'SNAP_EUID': str(os.geteuid()),
        'SNAP_DESKTOP_RUNTIME': f'{snap}/gnome-platform', 'GTK_USE_PORTAL': '1',
        # The official desktop-launch helper deliberately searches the parent
        # of this snap-specific directory for Wayland and PulseAudio sockets.
        'XDG_RUNTIME_DIR': snap_runtime,
        'PIPEWIRE_RUNTIME_DIR': session_runtime,
        'PULSE_SERVER': f'unix:{session_runtime}/pulse/native',
        # Some school images provide internet outside NetworkManager while its
        # system-bus state remains DISCONNECTED. Spotify trusts that false
        # signal over successful HTTPS/AP connections and forces all private
        # library and playback requests offline. Keep the session bus (MPRIS,
        # desktop integration) but hide only the incorrect system-bus signal;
        # Spotify then uses its built-in Ethernet connectivity fallback.
        'DBUS_SYSTEM_BUS_ADDRESS': f'unix:path={snap_runtime}/no-system-bus',
        'FONTCONFIG_PATH': f'{snap}/gnome-platform/etc/fonts',
        'FONTCONFIG_FILE': 'fonts.conf',
        'PATH': f'/usr/lib/snapd:{snap}/usr/sbin:{snap}/usr/bin:'
                f'{snap}/sbin:{snap}/bin:/usr/bin:/bin',
        # snapd normally seeds provider paths before invoking command-chain
        # helpers. We launch without snapd, so provide their signed in-container
        # locations explicitly; the helpers may safely append further subdirs.
        'LD_LIBRARY_PATH': ':'.join((
            f'{snap}/usr/lib/x86_64-linux-gnu', f'{snap}/usr/lib',
            f'{snap}/gnome-platform/lib/x86_64-linux-gnu',
            f'{snap}/gnome-platform/usr/lib/x86_64-linux-gnu',
            f'{snap}/gnome-platform/usr/lib/x86_64-linux-gnu/libproxy',
            f'{snap}/gnome-platform/usr/lib',
            f'{snap}/gpu-2404/usr/lib/x86_64-linux-gnu',
            f'{snap}/gpu-2404/usr/lib/x86_64-linux-gnu/dri',
        )),
    })
    if spotify_xauthority():
        env['XAUTHORITY'] = str(HOME / '.thin-client-Xauthority')
    else:
        env.pop('XAUTHORITY', None)
    return env

def spotify_audio_api(runtime=None):
    """Choose the usable host audio service, preferring the stable Pulse API."""
    runtime = runtime or Path('/run/user') / str(os.getuid())
    sockets = (('pulseaudio', runtime / 'pulse/native'),
               ('pipewire', runtime / 'pipewire-0'))
    for backend, path in sockets:
        try:
            if stat.S_ISSOCK(path.stat().st_mode):
                return backend
        except OSError:
            continue
    # PulseAudio is also the least surprising default on older school images;
    # Spotify will report a clear player error if no audio session exists.
    return 'pulseaudio'

def spotify_container_argv(root, release, metadata, app_args):
    """Build a no-root bubblewrap launch using the managed core24 filesystem."""
    if not BWRAP.is_file() or not os.access(BWRAP, os.X_OK):
        raise RuntimeError('Spotify needs /usr/bin/bwrap for its no-sudo core24 runtime')
    core = snap_runtime_release(root, 'core24')[0]
    gnome = snap_runtime_release(root, 'gnome-46-2404')[0]
    mesa = snap_runtime_release(root, 'mesa-2404')[0]
    themes = snap_runtime_release(root, 'gtk-common-themes')[0]
    layouts = spotify_layout_mounts(core, gnome, mesa)
    open_helper = spotify_open_helper()
    if (not open_helper.is_file() or open_helper.is_symlink() or
            not os.access(open_helper, os.X_OK)):
        raise RuntimeError('Spotify browser bridge is missing: run '
                           'thin-client-setup install-self')
    snapctl_helper = spotify_snapctl_helper()
    if (not snapctl_helper.is_file() or snapctl_helper.is_symlink() or
            not os.access(snapctl_helper, os.X_OK)):
        raise RuntimeError('Spotify Snap compatibility helper is missing: run '
                           'thin-client-setup install-self')
    ensure_spotify_mountpoints(release)
    # Validate every executable against the signed Spotify extraction before
    # translating it to the stable in-container mount path.
    spotify_launch(root, release, metadata)
    inside_snap = Path('/snap/spotify/current')
    command = [str(inside_snap / item) for item in metadata['command_chain']]
    command.append(str(inside_snap / metadata['command'][0]))
    command.extend(metadata['command'][1:])
    caches = safe(runtime_storage(root) / 'cache/spotify')
    temporary = safe(runtime_storage(root) / 'tmp/spotify')
    for directory in (caches, temporary, SPOTIFY / '.cache',
                      SPOTIFY / 'common/.cache', SPOTIFY / '.tmp'):
        directory.mkdir(parents=True, exist_ok=True)
    argv = [
        str(BWRAP), '--die-with-parent', '--ro-bind', str(core), '/',
        '--dev-bind', '/dev', '/dev', '--proc', '/proc', '--ro-bind', '/sys', '/sys',
        '--bind', '/run', '/run', '--tmpfs', '/home', '--dir', str(HOME),
        '--bind', str(SPOTIFY), str(SPOTIFY),
        '--bind', str(caches), str(SPOTIFY / '.cache'),
        '--bind', str(caches), str(SPOTIFY / 'common/.cache'),
        '--bind', str(temporary), str(SPOTIFY / '.tmp'),
        '--tmpfs', '/snap', '--dir', '/snap/spotify',
        '--ro-bind', str(release), str(inside_snap),
        '--ro-bind', str(gnome), str(inside_snap / 'gnome-platform'),
        '--ro-bind', str(mesa), str(inside_snap / 'gpu-2404'),
        '--ro-bind', str(open_helper), '/usr/bin/xdg-open',
        # core24 reserves this empty directory for snapd helpers. Binding our
        # reviewed helper directory avoids trying to create a file beneath the
        # read-only /usr tree.
        '--ro-bind', str(snapctl_helper.parent), '/usr/lib/snapd',
    ]
    # These bindings come from the official snap.yaml layouts. Without them,
    # the unpacked client can start but WebKit/API views and GPU configuration
    # are incomplete, which presents as empty profiles and unloaded playlists.
    for source, target in layouts:
        argv.extend(['--ro-bind', str(source), '/' + str(target.relative_to(core))])
    xauthority = spotify_xauthority()
    if xauthority:
        argv.extend(['--ro-bind', str(xauthority),
                     str(HOME / '.thin-client-Xauthority')])
    # The runtime provides Fontconfig itself, while the post provides the
    # installed font files. Keep both system font trees read-only.
    for font_directory in ('/usr/share/fonts', '/usr/local/share/fonts'):
        source = Path(font_directory)
        target = core / font_directory.lstrip('/')
        if source.is_dir() and target.is_dir():
            argv.extend(['--ro-bind', font_directory, font_directory])
    for subdirectory in ('themes', 'icons', 'sounds'):
        source = themes / 'share' / subdirectory
        if source.is_dir():
            argv.extend(['--ro-bind', str(source),
                         str(inside_snap / 'data-dir' / subdirectory)])
    # Share the host's live desktop/audio session and identity files while all
    # executable and library files continue to come from the signed runtime.
    for path in ('/etc/resolv.conf', '/etc/hosts', '/etc/machine-id',
                 '/etc/nsswitch.conf', '/etc/passwd', '/etc/group'):
        if Path(path).is_file():
            argv.extend(['--ro-bind-try', path, path])
    argv.extend(['--chdir', str(SPOTIFY), '--', *command, *app_args])
    return BWRAP, argv

def open_app(root, app, args):
    if any(a.startswith(('--user-data-dir', '--extensions-dir', '--disk-cache-dir',
                         '--disk-cache-size', '--disable-gpu', '--app=', '--class='))
           for a in args):
        raise RuntimeError('Storage overrides belong in the reviewed setup, not launcher arguments')
    if app == 'code':
        exe = root / 'apps/vscode/current/bin/code'
    elif app == 'brave':
        exe = root / 'apps/brave/current/brave'
    else:
        release, metadata = spotify_release(root)
        exe, spotify_argv = spotify_launch(root, release, metadata)
    if not os.access(exe, os.X_OK):
        raise RuntimeError('Goinfre app missing: run ~/.local/bin/thin-client-setup prepare explicitly')
    profiles = {'brave': BRAVE, 'code': CODE, 'spotify': SPOTIFY}
    profile = profiles[app]
    if not (profile / '.thin-client-import').exists():
        raise RuntimeError('Profile not prepared: run thin-client-setup migrate/integrate')
    safe(profile)
    if app == 'brave':
        brave_caches(root)
    elif app == 'code':
        vscode_caches(root)
    else:
        spotify_caches(root)
    env = (spotify_environment(root, release, metadata) if app == 'spotify' else
           environment(root, 'vscode' if app == 'code' else app))
    acceleration = gpu_args()
    if not acceleration:
        print('GPU acceleration unavailable on this post: no usable /dev/dri render node; '
              'using the application software renderer.', file=sys.stderr, flush=True)
    if app == 'brave':
        argv = [exe, f'--user-data-dir={BRAVE}', '--class=brave-native',
                '--disk-cache-size=104857600', *acceleration, *args]
    elif app == 'code':
        argv = [*code_args(root), *acceleration, *args]
    else:
        spotify_args = [*acceleration, *args]
        if not any(value == '--audio-api' or value.startswith('--audio-api=')
                   for value in spotify_args):
            # Recent official Linux builds can select a non-working PipeWire
            # path outside snapd. The host Pulse socket is stable across the
            # supported school images and is already shared into the sandbox.
            spotify_args.insert(0, f'--audio-api={spotify_audio_api()}')
        # Detailed logs are intentionally opt-in: level 8 grows quickly during
        # normal listening. The fixed path remains disposable and makes a
        # future diagnosis reproducible with THIN_CLIENT_SPOTIFY_DEBUG=1.
        if os.environ.get('THIN_CLIENT_SPOTIFY_DEBUG') == '1':
            if not any(value == '--log-file' or value.startswith('--log-file=')
                       for value in spotify_args):
                spotify_args.insert(0,
                                    f'--log-file={SPOTIFY / ".tmp/spotify-client.log"}')
            if not any(value == '--debug-level' or value.startswith('--debug-level=')
                       for value in spotify_args):
                spotify_args.insert(0, '--debug-level=8')
        exe, argv = spotify_container_argv(root, release, metadata, spotify_args)
        env['THIN_CLIENT_OPEN_FIFO'] = str(start_spotify_browser_bridge())
    os.execve(exe, [str(a) for a in argv], env)

def open_cli(root, name, args):
    locations = {'codex': root / 'apps/codex/bin/codex',
                 'claude': root / 'apps/claude/current/claude'}
    exe = locations[name]
    try:
        confined_executable(exe, root / 'apps' / name)
    except RuntimeError:
        raise RuntimeError(f'Goinfre {name} missing: run '
                           f'~/.local/bin/thin-client-setup {name} prepare explicitly')
    env = dict(os.environ)
    temporary = safe(runtime_storage(root) / 'tmp' / name)
    temporary.mkdir(parents=True, exist_ok=True)
    env['TMPDIR'] = str(temporary)
    if name == 'codex':
        state = safe(HOME / '.codex')
        state.mkdir(mode=0o700, parents=True, exist_ok=True)
        packages = state / 'packages'
        expected_packages = root / 'apps/codex/installer-home/packages'
        if not packages.is_symlink() or packages.resolve() != expected_packages.resolve():
            raise RuntimeError('Codex packages are still in HOME or point elsewhere: quit Codex, '
                               'then run thin-client-setup codex prepare')
        env['CODEX_HOME'] = str(state)
        env.pop('CODEX_INSTALL_DIR', None)
        daemon = packages / 'app-server-daemon/current/bin/codex'
        if not os.access(daemon, os.X_OK) and '--no-daemon' not in args:
            print('Codex daemon package is unavailable on this post; starting in supported '
                  '--no-daemon mode. Repair it later from a writable goinfre post.',
                  file=sys.stderr, flush=True)
            args = ['--no-daemon', *args]
    else:
        state = safe(HOME / '.claude')
        state.mkdir(mode=0o700, parents=True, exist_ok=True)
        env['CLAUDE_CONFIG_DIR'] = str(state)
        env['CLAUDE_CODE_TMPDIR'] = str(temporary)
        env['DISABLE_UPDATES'] = '1'
    os.execve(exe, [str(exe), *args], env)

def allocated(path):
    if not path.exists():
        return 0
    r = run(['du', '-x', '-B1', '-s', '--', path], capture_output=True, text=True)
    return int(r.stdout.split()[0])

def audit():
    """Only metadata: never dump profiles, settings, SSH config or auth contents."""
    run(['df', '-h', HOME])
    for path in [HOME / '.local', HOME / '.var', HOME / '.config',
                 OLD_BRAVE.parent.parent.parent, OLD_CODE.parent.parent.parent,
                 BRAVE, CODE, SPOTIFY]:
        print(f'{path}: {allocated(path)} allocated bytes', flush=True)
    try:
        root = goinfre(require_writable=False)
        mode = 'writable' if os.access(root, os.W_OK | os.X_OK) else 'read-only'
        print(f'Validated disposable storage: {root.parent} ({mode})', flush=True)
        run(['df', '-h', root.parent])
    except RuntimeError as error:
        print(f'Goinfre unavailable: {error}', flush=True)
    if shutil.which('flatpak'):
        run(['flatpak', 'ps', '--columns=application'])
    desktop_diagnostics()

