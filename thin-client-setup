            raise RuntimeError(f'Expected Codex directory: {path}')
    for path in (package / 'current', launchers / 'codex', launchers / 'codex-code-mode-host'):
        if path.is_symlink():
            if not path.resolve().is_relative_to(package / 'releases'):
                raise RuntimeError(f'Unrelated Codex symlink, left intact: {path}')
        elif path.exists():
            raise RuntimeError(f'Unrecognized Codex path, left intact: {path}')
    safe(storage).mkdir(parents=True, exist_ok=True)
    safe(launchers).mkdir(parents=True, exist_ok=True)
    with safe(storage / '.thin-client-install.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
