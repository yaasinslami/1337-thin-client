            print('Codex machine-local package already installed; no update or state changes.')
            return
        with tempfile.TemporaryDirectory(prefix='.installer-', dir=storage) as work:
            work = Path(work)
            installer = work / 'install.sh'
            run(['curl', '-fL', '--proto', '=https', '--proto-redir', '=https',
                 '--connect-timeout', '20', '--max-time', '120',
                 '-o', installer, 'https://chatgpt.com/codex/install.sh'])
            isolated_home = work / 'home'
            isolated_home.mkdir()
            # Do not inherit daemon-only/updater flags or an existing runtime CODEX_HOME.
            env = {key: value for key, value in os.environ.items() if not key.startswith('CODEX_')}
            env.update(HOME=str(isolated_home), CODEX_HOME=str(storage),
                       CODEX_INSTALL_DIR=str(launchers), CODEX_NON_INTERACTIVE='1',
                       PATH=f'{launchers}:/usr/local/bin:/usr/bin:/bin', TMPDIR=str(work),
                       XDG_CONFIG_HOME=str(isolated_home / 'config'),
                       XDG_CACHE_HOME=str(work / 'cache'), XDG_DATA_HOME=str(isolated_home / 'data'))
            run(['sh', installer], env=env, stdin=subprocess.DEVNULL)
        if not codex_installed(root):
            raise RuntimeError('Installer finished without a valid goinfre Codex launcher')
    codex_status(root)


SESSION_LOG_LIMIT = 4096
SESSION_RETRY_SECONDS = 300
SESSION_NAME = '1337 Thin Client Session'


def session_entry():
    return HOME / '.config/autostart/1337-thin-client.desktop'


def session_entry_contents():
    # Desktop Exec quoting is not shell quoting. Escape reserved characters in
    # the absolute executable, and escape literal percent field-code markers.
    if any(char in str(SELF) for char in ('\n', '\r', '=')):
        raise RuntimeError('Installed script path cannot be represented safely in desktop Exec')
    executable = str(SELF).replace('\\', '\\\\').replace('"', '\\"').replace('`', '\\`').replace('$', '\\$')
    executable = executable.replace('%', '%%').replace('\\', '\\\\')
    return ('[Desktop Entry]\n# Managed by thin-client-setup\nType=Application\n'
            f'Name={SESSION_NAME}\n'
            'Comment=Initialize the 1337 thin-client environment for this workstation\n'
            f'Exec="{executable}" session-init\n'
            'Terminal=false\nNoDisplay=true\nStartupNotify=false\n'
            'X-GNOME-Autostart-enabled=true\n')


def owned_session_entry(path):
    return (path.is_file() and not path.is_symlink() and
            '# Managed by thin-client-setup' in path.read_text().splitlines() and
            desktop_fields(path).get('Name') == SESSION_NAME)


def session_enable():
    path = safe(session_entry())
    if path.exists() and not owned_session_entry(path):
        raise RuntimeError(f'Refusing unrelated autostart entry: {path}')
    safe(path.parent).mkdir(parents=True, exist_ok=True)
    managed_file(path, session_entry_contents(), 0o644)
    print('Thin-client graphical session autostart enabled.')


def session_disable():
    path = safe(session_entry())
    if path.exists():
        if not owned_session_entry(path):
            raise RuntimeError(f'Refusing unrelated autostart entry: {path}')
        path.unlink()
    print('Thin-client graphical session autostart disabled.')


def refresh_session_entry():
    """Upgrade existing opt-in integration; never create it or undo disablement."""
    path = session_entry()
    if not path.exists() and not path.is_symlink():
        return
    try:
        safe(path)
        if not owned_session_entry(path):
            return
        fields = desktop_fields(path)
        if fields.get('Hidden') == 'true' or fields.get('X-GNOME-Autostart-enabled') == 'false':
            return
        managed_file(path, session_entry_contents(), 0o644)
    except (OSError, RuntimeError, UnicodeError, configparser.Error):
        print('Session autostart update skipped; inspect thin-client-setup session status.')


def remove_legacy_zsh_trigger():
    """One-time maintenance helper; never called by any normal CLI workflow."""
    path = safe(HOME / '.zshrc')
    if not path.exists():
        return
    before = path.read_bytes()
    begin = b'# >>> 1337 thin-client session >>>'
    end = b'# <<< 1337 thin-client session <<<'
    if begin not in before and end not in before:
        return
    candidates = [(begin + b'\n'
                   b'if [[ -o interactive ]] && command -v thin-client-setup >/dev/null; then\n'
                   b'    thin-client-setup session-init' + guard + b'\n'
                   b'fi\n' + end + b'\n') for guard in (b' || :', b'')]
    match = next((block for block in candidates if before.count(block) == 1), None)
    if (match is None or before.count(begin) != 1 or before.count(end) != 1 or
            (before.index(match) and before[before.index(match) - 1:before.index(match)] != b'\n')):
        raise RuntimeError('Unrecognized legacy zsh session block; left intact')
    after = before.replace(match, b'', 1)
    fd, temporary = tempfile.mkstemp(prefix='.zshrc-thin-client-', dir=HOME)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(after)
        os.chmod(temporary, stat.S_IMODE(path.stat().st_mode))
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)
    print('Removed only the exact legacy zsh session trigger.')


def core_ready(root):
    return (all(os.access(root / p, os.X_OK) for p in
                ('apps/brave/current/brave', 'apps/vscode/current/bin/code')) and
            all(p.is_file() for p in (BRAVE / '.thin-client-import', CODE / '.thin-client-import',
                                     HOME / '.local/bin/brave-native', HOME / '.local/bin/code-native')) and
            all((root / p).is_dir() for p in
                ('vscode-extensions', 'runtime/brave/config', 'runtime/brave/cache')))


def read_session_log(root):
    path = safe(root / 'runtime/session-init.log')
    if not path.exists():
        return {}
    if not path.is_file():
        raise RuntimeError('Expected a regular session log')
    with path.open('rb') as stream:
        data = stream.read(SESSION_LOG_LIMIT + 1)
    if len(data) > SESSION_LOG_LIMIT:
        return {}
    try:
        value = json.loads(data)
        return value if isinstance(value, dict) else {}
    except (ValueError, UnicodeError):
        return {}


def write_session_log(runtime, record):
    """Only fixed metadata, atomically replaced each run; never child output."""
    path = safe(runtime / 'session-init.log')
    data = (json.dumps(record, indent=2) + '\n').encode()
    if len(data) > SESSION_LOG_LIMIT:
        raise RuntimeError('Session log exceeds its fixed bound')
    fd, temporary = tempfile.mkstemp(prefix='.session-init-', dir=runtime)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


@contextlib.contextmanager
def core_prepare_guard(root):
    """Direct prepare uses the same exclusive lock; autostart adopts its FD."""
    path = session_lock_path(root)
    inherited = os.environ.get(PREPARE_LOCK_FD)
    if inherited is not None:
        try:
            fd = int(inherited)
            opened, expected = os.fstat(fd), path.stat()
        except (ValueError, OSError) as error:
            raise RuntimeError('Invalid inherited preparation lock') from error
        if (not stat.S_ISREG(opened.st_mode) or
                (opened.st_dev, opened.st_ino) != (expected.st_dev, expected.st_ino)):
            raise RuntimeError('Invalid inherited preparation lock')
        lock = os.fdopen(os.dup(fd), 'a')
    else:
        lock = path.open('a')
    with lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RuntimeError('Core preparation or an application launch is active; '
                               'quit native apps and check thin-client-setup session status') from error
        runtime = root / 'runtime'
        record = {'timestamp': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
                  'core': 'preparing', 'prepare_started': True,
                  'attempted_at': time.time(), 'result': 'running'}
        write_session_log(runtime, record)
        try:
            yield
        except BaseException as error:
            record.update(result='failed', error=type(error).__name__)
            write_session_log(runtime, record)
            raise
        else:
            record.update(result='success', core='ready' if core_ready(root) else 'incomplete')
            write_session_log(runtime, record)


def session_status():
    print('1337 session')
    path = session_entry()
    try:
        safe(path)
        if not path.exists():
            state = 'disabled'
        elif not owned_session_entry(path):
            state = 'MISMATCH: unrecognized entry'
        elif (desktop_fields(path).get('Hidden') == 'true' or
              desktop_fields(path).get('X-GNOME-Autostart-enabled') == 'false'):
            state = 'disabled'
        else:
            state = 'enabled' if path.read_text() == session_entry_contents() else 'MISMATCH: run session enable'
    except (OSError, RuntimeError, UnicodeError, configparser.Error):
        state = 'MISMATCH: unsafe or unreadable entry'
    print(f'  Autostart {state}')
    try:
        root = goinfre()
    except (OSError, RuntimeError):
        root = None
    print(f'  Core     {"ready" if root is not None and core_ready(root) else "not prepared"}')
    for label, relative in (('Brave', 'apps/brave/current/brave'), ('Code', 'apps/vscode/current/bin/code')):
        ready = root is not None and os.access(root / relative, os.X_OK)
        print(f'  {label:8} {"ready" if ready else "not prepared"}')
    print(f'  Codex    {"installed" if codex_installed(root) else "not installed on this post"}')
    try:
        usage = shutil.disk_usage(HOME)
        print(f'  HOME fs  {usage.free / 2**30:.1f}G free / {usage.total / 2**30:.1f}G')
    except OSError:
        print('  HOME fs  unavailable')
    try:
        last = read_session_log(root).get('result', 'not run') if root is not None else 'not run'
    except (OSError, RuntimeError):
        last = 'unavailable'
    if last not in ('success', 'failed', 'running', 'not run', 'unavailable'):
        last = 'unrecognized record'
    print(f'  Last init {"successful" if last == "success" else last}')


def session_init():
    """Silent ready path; autostart is an independent child, returning 1 on failure."""
    runtime, record = None, {'timestamp': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}
    try:
        root = goinfre()
        ready = core_ready(root)  # Only local artifacts; no version/update checks.
        runtime = safe(root / 'runtime')
        runtime.mkdir(parents=True, exist_ok=True)
        lock_path = session_lock_path(root)
        with lock_path.open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return 0  # Do not overwrite the active initializer's log.
            ready = core_ready(root)  # Recheck actual artifacts after acquiring the lock.
            record['core'] = 'ready' if ready else 'new/unprepared post'
            record['prepare_started'] = False
            if not ready:
                previous = read_session_log(root)
                now = time.time()
                attempted = previous.get('attempted_at')
                if (previous.get('result') == 'failed' and isinstance(attempted, (int, float)) and
                        0 <= now - attempted < SESSION_RETRY_SECONDS):
                    record.update(result='failed', attempted_at=attempted,
                                  error='recent preparation failed; retry later or run prepare manually')
                    write_session_log(runtime, record)
                    print('Thin-client session setup recently failed; run thin-client-setup prepare for details.', file=sys.stderr)
                    return 1
                record.update(prepare_started=True, attempted_at=now, result='running')
                write_session_log(runtime, record)
                # No child output is stored: it can contain browser/profile paths.
                # Inherit the lock so a killed parent cannot start a second prepare
                # while the original child is still running.
                result = subprocess.run([sys.executable, str(Path(__file__).resolve()), 'prepare'],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                        env={**os.environ, PREPARE_LOCK_FD: str(lock.fileno())},
                                        pass_fds=(lock.fileno(),), check=False)
                record['prepare_exit'] = result.returncode
                ready = result.returncode == 0 and core_ready(root)
            record['result'] = 'success' if ready else 'failed'
            write_session_log(runtime, record)
            if not ready:
                print('Thin-client session setup failed; run thin-client-setup prepare for details.', file=sys.stderr)
            return 0 if ready else 1
    except (OSError, RuntimeError, ValueError) as error:
        record.update(result='failed', error=type(error).__name__)
        if runtime is not None:
            try:
                write_session_log(runtime, record)
            except (OSError, RuntimeError):
                pass
        print('Thin-client session setup unavailable; run thin-client-setup session status.', file=sys.stderr)
        return 1


def flatpak_path(app):
    if app not in APP_IDS:
        raise RuntimeError('Only brave or vscode may be retired by this tool')
    path = HOME / '.var/app' / APP_IDS[app]
    safe(path)
    if path.parent != HOME / '.var/app':
        raise RuntimeError('Invalid Flatpak retirement path')
    return path

def backup_flatpak(app, source, root):
    directory = safe(root / 'legacy-backups')
    directory.mkdir(parents=True, exist_ok=True)
    destination = Path(tempfile.mkdtemp(prefix=f'{app}-{time.strftime("%Y%m%d-%H%M%S")}-', dir=directory))
    if app == 'brave':
        source = source / 'config/BraveSoftware/Brave-Browser'
        if not (source / 'Local State').is_file():
            raise RuntimeError('Cannot back up incomplete Brave profile')
    else:
        source = source / 'config/Code/User'
        if not source.is_dir():
            raise RuntimeError('Cannot back up missing VS Code User directory')
    safe(source)
    excludes = brave_copy_excludes(source) if app == 'brave' else []
    excludes += ['--exclude=Singleton*', '--exclude=*.lock', '--exclude=*.sock',
                 '--exclude=.org.chromium.*']
    payload = destination / 'persistent-data'
    run(['rsync', '-a', *excludes, str(source) + '/', str(payload) + '/'])
    verify = run(['rsync', '-anc', '--itemize-changes', *excludes,
                  str(source) + '/', str(payload) + '/'], capture_output=True, text=True)
    if verify.stdout.strip():
        raise RuntimeError('Backup verification failed; old data was not deleted')
    rows = []
    for path in sorted(payload.rglob('*')):
        if path.is_symlink():
            original = source / path.relative_to(payload)
            if os.readlink(path) != os.readlink(original):
                raise RuntimeError('Backup link mismatch')
            data = os.readlink(path).encode()
            rows.append({'source': str(original), 'backup': str(path), 'type': 'symlink',
                         'sha256': hashlib.sha256(data).hexdigest(), 'size': path.lstat().st_size})
        elif path.is_file():
            original = source / path.relative_to(payload)
            checksum = digest(original)
            if checksum != digest(path):
                raise RuntimeError('Backup checksum mismatch')
            rows.append({'source': str(original), 'backup': str(path), 'type': 'file',
                         'sha256': checksum, 'size': path.stat().st_size})
    (destination / 'manifest.json').write_text(json.dumps(rows, indent=2) + '\n')
    print(f'Verified temporary backup: {destination}; {allocated(destination)} bytes', flush=True)
    return destination

def retire_flatpak(root, app, *, dry_run=False, verified=False, yes=False, backup=True):
    path = flatpak_path(app)
    print(f'Exact retirement path: {path}; {allocated(path)} allocated bytes', flush=True)
    if dry_run:
        print(f'DRY RUN: would check stopped apps/replacement/verification, '
              f'{"back up persistent data, " if backup else ""}then remove only {path}', flush=True)
        return
    if not verified:
        raise RuntimeError('Manual replacement verification required: pass --verified after GUI checks')
    profile = BRAVE if app == 'brave' else CODE
    executable = root / ('apps/brave/current/brave' if app == 'brave' else 'apps/vscode/current/bin/code')
    if not (profile / '.thin-client-import').is_file() or not os.access(executable, os.X_OK):
        raise RuntimeError('Native replacement/profile is not ready')
    safe(profile)
    stopped((app,))
    schemes = ['http', 'https'] if app == 'brave' else ['vscode']
    expected = 'brave-native.desktop' if app == 'brave' else 'code-native-url-handler.desktop'
    for scheme in schemes:
        selected = run(['xdg-mime', 'query', 'default', f'x-scheme-handler/{scheme}'],
                       capture_output=True, text=True).stdout.strip()
        if selected != expected:
            raise RuntimeError(f'{scheme} still points elsewhere; review native handler integration first')
    if not path.is_dir():
        raise RuntimeError('Retirement directory is missing; nothing deleted')
    if not yes:
        if not sys.stdin.isatty() or input(f'Type {APP_IDS[app]} to remove the exact directory: ') != APP_IDS[app]:
            raise RuntimeError('Retirement not confirmed')
    if backup:
        backup_flatpak(app, path, root)
    stopped((app,))
    flatpak_path(app)  # Check again immediately before removing only this tree.
    print(f'Removing ONLY {path}', flush=True)
    shutil.rmtree(path)

def cli_parser():
    parser = argparse.ArgumentParser(description='Native Brave + VS Code thin client; no HOME binary fallback')
    parser.add_argument('--version', action='version', version=f'thin-client-setup {VERSION}')
    subs = parser.add_subparsers(dest='command', required=True)
    for command in ['audit', 'doctor', 'status', 'install-self', 'install', 'migrate', 'integrate', 'desktop', 'prepare', 'browser-default']:
        sub = subs.add_parser(command)
        sub.add_argument('--dry-run', action='store_true')
        if command in ['integrate', 'prepare']:
            sub.add_argument('--make-default-browser', action='store_true', help='Explicit consent to native HTTP/HTTPS defaults')
    sub = subs.add_parser('defaults', help='Explicitly register the native browser and Code callback')
    sub.add_argument('browser', choices=['brave'])
    sub.add_argument('--dry-run', action='store_true')
    subs.add_parser('session-init', help='Graphical login initializer; bootstrap only missing core applications')
    sub = subs.add_parser('session', help='Opt-in XDG Autostart and read-only session diagnostics')
    sub.add_argument('action', choices=['enable', 'disable', 'status', 'run'],
                     help='enable/disable autostart, inspect status, or run initialization manually')
    sub = subs.add_parser('codex', help='Explicit optional standalone installation or read-only status')
    sub.add_argument('action', choices=['status', 'install'])
    sub.add_argument('--dry-run', action='store_true')
    sub = subs.add_parser('open')
    sub.add_argument('app', choices=['brave', 'code'])
    sub.add_argument('args', nargs=argparse.REMAINDER)
    sub = subs.add_parser('retire-flatpak')
    sub.add_argument('app', choices=sorted(APP_IDS))
    sub.add_argument('--dry-run', action='store_true')
    sub.add_argument('--verified', action='store_true', help='Confirm you completed manual GUI checks')
    sub.add_argument('--yes', action='store_true', help='Explicitly confirm removal of the displayed app directory')
    sub.add_argument('--no-backup', action='store_true', help='Explicitly skip the temporary persistent-data backup')
    return parser

def main(argv=None):
    options = cli_parser().parse_args(argv)
    command = options.command
    if command in ['audit', 'doctor']:
        (audit if command == 'audit' else doctor)()
        return
    if command == 'install-self':
        if options.dry_run:
            print('DRY RUN: install-self; installed script unchanged')
            return
        safe(STATE).mkdir(parents=True, exist_ok=True)
        with (STATE / 'setup.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            install_self()
        return
    if command == 'status':
        script_status()
        desktop_diagnostics()
    if command == 'session-init':
        return session_init()
    if command == 'session':
        if options.action == 'run':
            return session_init()
        {'enable': session_enable, 'disable': session_disable, 'status': session_status}[options.action]()
        return
    if command == 'codex':
        if options.dry_run:
            print(f'DRY RUN: codex {options.action}; no files or persistent state changed')
            return
        if options.action == 'status':
            try:
                root = goinfre()
            except RuntimeError:
                root = None
            codex_status(root)
        else:
            install_codex(goinfre())
        return
    root = goinfre()
    print(f'Goinfre: {root}\nBrave persistent profile: {BRAVE}\nVS Code persistent state: {CODE}', flush=True)
    if command == 'status':
        for p in [root / 'apps/brave/current', root / 'apps/vscode/current', BRAVE, CODE, root / 'vscode-extensions']:
            print(p, 'present' if p.exists() else 'missing')
        if not all(os.access(root / exe, os.X_OK) for exe in
                   ['apps/brave/current/brave', 'apps/vscode/current/bin/code']):
            print('New/unprepared workstation detected. Run: ~/.local/bin/thin-client-setup prepare '
                  '(after quitting applications). No downloads were started.', flush=True)
        return
    if getattr(options, 'dry_run', False):
        if command == 'retire-flatpak':
            retire_flatpak(root, options.app, dry_run=True, backup=not options.no_backup)
        else:
            print(f'DRY RUN: {command}; no files, locks, downloads or handlers changed')
        return
    if command == 'open':
        open_app(root, options.app, options.args)
        return
    os.umask(0o077)
    safe(STATE).mkdir(parents=True, exist_ok=True)
    preparation = (core_prepare_guard(root) if command in ['prepare', 'install', 'migrate', 'integrate']
                   else contextlib.nullcontext())
    with preparation, (STATE / 'setup.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        safe(root).mkdir(parents=True, exist_ok=True)
        if command in ['install', 'integrate', 'desktop', 'prepare', 'defaults']:
            install_self()
        if command in ['install', 'prepare']:
            install(root)
        if command in ['migrate', 'prepare']:
            migrate(root)
        if command in ['integrate', 'prepare']:
            integrate(root)
        if command in ['desktop', 'defaults']:
            desktop_integration(root)
        if command in ['browser-default', 'defaults'] or getattr(options, 'make_default_browser', False):
            make_default_browser()
        if command == 'retire-flatpak':
            retire_flatpak(root, options.app, verified=options.verified, yes=options.yes,
                           backup=not options.no_backup)
    print('Requested step complete.', flush=True)

if __name__ == '__main__':
    try:
        sys.exit(main() or 0)
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError, zipfile.BadZipFile, tarfile.TarError) as e:
        print(f'STOPPED: {e}', file=sys.stderr)
        sys.exit(1)
