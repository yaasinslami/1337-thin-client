def cli_shim_plan():
    """Accept only exact native-wrapper locations, never basename matches."""
    directory = safe(HOME / '.local/bin')
    plan = []
    for app in ('code', 'brave'):
        path = directory / app
        target = directory / (app + '-native')
        if path.is_symlink():
            raw = Path(os.readlink(path))
            old = Path(os.path.abspath(raw if raw.is_absolute() else path.parent / raw))
            if old == target:
                continue
            # Older user-bin native wrappers are the only accepted stale targets.
            if old != HOME / 'bin' / (app + '-native'):
                raise RuntimeError(f'Refusing to overwrite unrelated CLI symlink: {path} -> {raw}')
            safe(old)
            if old.exists() and (not old.is_file() or
                    '# Managed by thin-client-setup' not in old.read_text().splitlines()):
                raise RuntimeError(f'Refusing to replace CLI link to unmanaged wrapper: {path}')
        elif path.exists():
            raise RuntimeError(f'Refusing to overwrite existing CLI path: {path}')
        plan.append((path, target))
    return plan

def install_cli_shims():
    plan = cli_shim_plan()  # Check both collisions before changing either link.
    safe(HOME / '.local/bin').mkdir(parents=True, exist_ok=True)
    for path, target in plan:
        if path.is_symlink():
            # Publish the replacement atomically; never follow the old link.
            with tempfile.TemporaryDirectory(prefix='.cli-shim-', dir=path.parent) as staging:
                link = Path(staging) / path.name
                link.symlink_to(target)
                os.replace(link, path)
        else:
            path.symlink_to(target)  # Refuses a newly appeared collision.
        print(f'CLI shim: {path} -> {target}', flush=True)

def cli_diagnostics():
    for app in ('code', 'brave'):
        path = HOME / '.local/bin' / app
        target = path.with_name(app + '-native')
        raw = Path(os.readlink(path)) if path.is_symlink() else None
        correct = raw is not None and Path(os.path.abspath(
            raw if raw.is_absolute() else path.parent / raw)) == target
        print(f'CLI {app}: {path} -> {app}-native; {"OK" if correct else "MISMATCH"}', flush=True)
        found = shutil.which(app)
        match = found is not None and Path(os.path.abspath(found)) == path
        print(f'CLI {app} PATH: {found or "not found"}; '
              f'{"OK" if match else "MISMATCH: put ~/.local/bin first in PATH; shell configuration unchanged"}', flush=True)

def install_self():
    source = Path(__file__).resolve()
    safe(SELF)
    cli_shim_plan()
    if source == SELF.resolve():
        refresh_session_entry()
        install_cli_shims()
        return
    safe(SELF.parent).mkdir(parents=True, exist_ok=True)
    managed_file(SELF, source.read_text(), 0o755)
    if digest(source) != digest(SELF):
        raise RuntimeError('Installed script differs after update; inspect before proceeding')
    refresh_session_entry()
    install_cli_shims()
    print(f'Installed setup {VERSION}: {SELF}; SHA-256 {digest(SELF)}', flush=True)

def script_status():
    """Compare script bytes, without mistaking a git pull for an installed update."""
    source = Path(__file__).resolve()
    print(f'Executing setup {VERSION}: {source}; SHA-256 {digest(source)}', flush=True)
    if (source.parent / '.git').exists():
        result = run(['git', '-C', source.parent, 'rev-parse', 'HEAD'],
                     capture_output=True, text=True)
        print(f'Checkout HEAD: {result.stdout.strip()} (script hash includes local edits)', flush=True)
    if SELF.is_file():
        installed_hash = digest(SELF)
        print(f'Installed setup: {SELF}; SHA-256 {installed_hash}', flush=True)
        if installed_hash != digest(source):
            print('UPDATE REQUIRED: run ./thin-client-setup install-self from the reviewed checkout', flush=True)
        else:
            print('Installed script matches executing script.', flush=True)
    else:
        print('Installed script missing: run ./thin-client-setup install-self from the reviewed checkout', flush=True)
    if source == SELF.resolve():
        print('Repository version unknown from installed copy; run ./thin-client-setup status '
              'in the checkout after git pull to compare.', flush=True)

def xdg_environment():
    env = dict(os.environ)
    env['XDG_CONFIG_HOME'] = str(HOME / '.config')
    env['XDG_DATA_HOME'] = str(HOME / '.local/share')
    return env

def desktop_menu_diagnostics():
    apps = HOME / '.local/share/applications'
    icons = HOME / '.local/share/icons/hicolor'
    ok = True
    for title, command, known_id, detected in [
            ('Brave', 'brave-native', 'com.brave.Browser.desktop', system_brave_desktop_ids()),
            ('Code', 'code-native', 'com.visualstudio.code.desktop', system_code_desktop_ids())]:
        entry = apps / f'{command}.desktop'
        fields = desktop_fields(entry)
        print(f'Native {title} desktop entry: {"present" if entry.is_file() else "MISSING"}', flush=True)
        target = Path(fields.get('Icon', ''))
        valid = (target.is_absolute() and target.name == f'{command}.png' and
                 target.parent.name == 'apps' and target.parent.parent.parent == icons and
                 target.is_file() and not target.is_symlink() and target.resolve() == target.absolute())
        print(f'Native {title} icon: {"present" if valid else "MISMATCH: missing or invalid"}; '
              f'target: {fields.get("Icon", "unset")}', flush=True)
        ok = ok and valid
        print(f'Hidden system {"VS Code" if title == "Code" else title} entries:', flush=True)
        for name in sorted({known_id, *detected}):
            match = desktop_fields(apps / name).get('Hidden') == 'true'
            print(f'  {name}: {"hidden" if match else "MISMATCH: not masked; run thin-client-setup desktop"}', flush=True)
            ok = ok and match
    if not ok:
        print('Run thin-client-setup desktop to restore native icons and system application masks.', flush=True)
    print('If GNOME retains stale menu entries after desktop setup, logout/login refreshes its shell cache.', flush=True)
    return ok

def desktop_diagnostics():
    """Report actual defaults against the explicit native deployment choice."""
    cli_diagnostics()
    checks = [('default web browser', ['xdg-settings', 'get', 'default-web-browser'],
               'brave-native.desktop')]
    checks += [(f'{scheme} handler', ['xdg-mime', 'query', 'default', f'x-scheme-handler/{scheme}'],
                'code-native-url-handler.desktop' if scheme == 'vscode' else 'brave-native.desktop')
               for scheme in ['http', 'https', 'vscode']]
    ok = True
    for label, command, expected in checks:
        try:
            value = run(command, capture_output=True, text=True,
                        env=xdg_environment()).stdout.strip() or 'unset'
            match = value == expected
        except (OSError, subprocess.CalledProcessError):
            value, match = 'unavailable (query failed)', False
        print(f'{label}: {value}; expected {expected}; {"OK" if match else "MISMATCH"}', flush=True)
        ok = ok and match
    apps = HOME / '.local/share/applications'
    for name in ['brave-native.desktop', 'code-native.desktop', 'code-native-url-handler.desktop']:
        present = (apps / name).is_file()
        print(f'Expected desktop entry: {apps / name}; {"present" if present else "MISSING"}', flush=True)
        ok = ok and present
    menu_ok = desktop_menu_diagnostics()
    if 'BROWSER' in os.environ:
        print('BROWSER is set in the shell; native Code omits it and uses desktop handlers.', flush=True)
    if not ok:
        print('For the native deployment, run thin-client-setup defaults brave explicitly. '
              'Diagnostics do not change defaults.', flush=True)
    return ok and menu_ok

def make_default_browser():
    apps = HOME / '.local/share/applications'
    for name in ['brave-native.desktop', 'code-native-url-handler.desktop']:
        if not (apps / name).is_file():
            raise RuntimeError('Run integrate/desktop before registering defaults')
    run(['xdg-settings', 'set', 'default-web-browser', 'brave-native.desktop'], env=xdg_environment())
    for scheme in ['http', 'https']:
        run(['xdg-mime', 'default', 'brave-native.desktop', f'x-scheme-handler/{scheme}'],
            env=xdg_environment())
    run(['xdg-mime', 'default', 'code-native-url-handler.desktop', 'x-scheme-handler/vscode'],
        env=xdg_environment())
    if not desktop_diagnostics():
        raise RuntimeError('Desktop defaults did not match after registration; see diagnostics above')
    print('Explicit choice applied: native Brave is the HTTP/HTTPS default', flush=True)

